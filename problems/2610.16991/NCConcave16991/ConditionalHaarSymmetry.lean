import NCConcave16991.HaarMoments
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-!
# Conditional moments from actual Haar symmetries

A right translation which leaves the observed images unchanged has the same
integrals on every event generated by those observations. Conditional
expectation uniqueness therefore gives the corresponding conditional symmetry.
No conditional distribution or moment assertion is supplied as a premise.
-/

open Set MeasureTheory

namespace NCConcave16991.Haar

noncomputable section

instance haarLaw_isHaar (k : ℕ) : Measure.IsHaarMeasure (haarLaw k) :=
  Measure.isHaarMeasure_of_isCompact_nonempty_interior (haarLaw k) univ isCompact_univ
    (by simp) (by simp) (by simp)

instance haarLaw_rightInvariant (k : ℕ) : Measure.IsMulRightInvariant (haarLaw k) := by
  constructor
  intro R
  exact Measure.isHaarMeasure_eq_of_isProbabilityMeasure _ _

variable {k : ℕ} {X : Type*} [mX : MeasurableSpace X]

/-- A fiber-preserving genuine Haar symmetry identifies actual conditional
expectations with respect to the sigma-field of observed data. -/
theorem conditional_right_symmetry (obs : OrthogonalGroup k → X) (hobs : Measurable obs)
    (R : OrthogonalGroup k) (hfix : ∀ Q, obs (Q * R) = obs Q)
    {f g : OrthogonalGroup k → ℝ} (hf : Integrable f (haarLaw k))
    (hg : Integrable g (haarLaw k)) (hfg : ∀ Q, f (Q * R) = g Q) :
    (haarLaw k)[f | mX.comap obs] =ᵐ[haarLaw k] (haarLaw k)[g | mX.comap obs] := by
  have hm : mX.comap obs ≤ (inferInstance : MeasurableSpace (OrthogonalGroup k)) := hobs.comap_le
  apply Filter.EventuallyEq.symm
  apply ae_eq_condExp_of_forall_setIntegral_eq hm hf
    (fun s _ _ ↦ integrable_condExp.integrableOn) _
    stronglyMeasurable_condExp.aestronglyMeasurable
  intro s hs hfin
  rw [setIntegral_condExp hm hg hs]
  have hsambient : MeasurableSet s := hm s hs
  change ∃ s0 : Set X, MeasurableSet s0 ∧ obs ⁻¹' s0 = s at hs
  obtain ⟨s0, hs0, rfl⟩ := hs
  have hinv := integral_mul_right_eq_self (μ := haarLaw k)
    ((obs ⁻¹' s0).indicator f) R
  have hpoint (Q : OrthogonalGroup k) :
      (obs ⁻¹' s0).indicator f (Q * R) = (obs ⁻¹' s0).indicator g Q := by
    classical
    by_cases hQ : obs Q ∈ s0
    · simp only [Set.indicator_apply, Set.mem_preimage, hfix, hQ, ite_true, hfg]
    · simp only [Set.indicator_apply, Set.mem_preimage, hfix, hQ, ite_false]
  simp_rw [hpoint] at hinv
  rw [integral_indicator hsambient, integral_indicator hsambient] at hinv
  exact hinv

theorem conditional_zero_of_right_negation (obs : OrthogonalGroup k → X)
    (hobs : Measurable obs) (R : OrthogonalGroup k)
    (hfix : ∀ Q, obs (Q * R) = obs Q)
    {f : OrthogonalGroup k → ℝ} (hf : Integrable f (haarLaw k))
    (hneg : ∀ Q, f (Q * R) = -f Q) :
    (haarLaw k)[f | mX.comap obs] =ᵐ[haarLaw k] fun _ ↦ (0 : ℝ) := by
  have hs := conditional_right_symmetry obs hobs R hfix hf hf.neg hneg
  have hn := condExp_neg (μ := haarLaw k) f (mX.comap obs)
  filter_upwards [hs, hn] with Q hQ hN
  rw [hN] at hQ
  change ((haarLaw k)[f | mX.comap obs]) Q = -((haarLaw k)[f | mX.comap obs]) Q at hQ
  linarith

end

end NCConcave16991.Haar
