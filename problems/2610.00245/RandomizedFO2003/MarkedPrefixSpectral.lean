import RandomizedFO2003.PrefixKrylov
import RandomizedFO2003.MarkedQueryDepth
import RandomizedFO2003.MarkedReadoutEvent

namespace RandomizedFO2003.Rotations

open MeasureTheory SpectralCoordinates

universe u

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]

omit [FiniteDimensional ℝ E] in
theorem MarkedProgram.query_mem_of_prefixQueries (t : ℕ) {H : Type u} [MeasurableSpace H]
    (plan : MarkedProgram E t H) (A : E →L[ℝ] E) (mark : H → E) (hm : Measurable mark)
    (u : E) (N : Submodule ℝ E) (a : Fin t → Bool) (k : ℕ)
    (p : ActionHistory E (markedActionCount t) H)
    (hp : (plan.compile A t mark hm).prefixQueries A.toLinearMap u N (markedActionCount t)
      (markedOperations t a) k p) :
    ∀ i, markedQueryTrace E t p i ∈ powerKrylovSpace A.toLinearMap u (markedQueryDepth t a k i) ⊔ N := by
  induction t generalizing H k with
  | zero => intro i; exact i.elim0
  | succ t ih =>
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact hp.2.1 rfl
    · exact ih plan.2 (mark ∘ ActionHistory.seed E 3) (hm.comp (ActionHistory.seed_measurable 3))
        (fun i => a i.succ) (LatentOperation.matrix.nextDepth ((LatentOperation.mark (a 0)).nextDepth k))
        p hp.2.2.2 j

/-- Every query has its own prefix degree bound, on the same full-horizon
ambient sample and with the same nuisance space generated by all starts. -/
theorem MarkedProgram.query_prefix_spectral {J : ℕ} (K : Fin J → ℕ) (node : Fin J → ℝ)
    (d t : ℕ) {H Ω : Type u} [MeasurableSpace H] [MeasurableSpace Ω]
    (plan : MarkedProgram (BlockSpace K) t H) (mark : H → BlockSpace K) (hm : Measurable mark)
    (F : Ω → ExposureFrame (Coordinates (d + markedActionCount t)) (BlockSpace K)) (history : Ω → H)
    (p : AmbientPairHistory (BlockSpace K) (markedActionCount t) Ω)
    (hsupport : (F (AmbientPairHistory.seed (BlockSpace K) (markedActionCount t) p)).KnownSupport)
    (hknown : embeddingComplement (F (AmbientPairHistory.seed (BlockSpace K) (markedActionCount t) p)).latent = ⊥)
    (hgood : (plan.compile (continuousDiagonal K node) t mark hm).directAmbientGood
      d (markedActionCount t) F history p) :
    let transcript := (plan.compile (continuousDiagonal K node) t mark hm).directAmbientTranscript
      d (markedActionCount t) F history p
    ∀ i, markedQueryTrace (BlockSpace K) t transcript i ∈
      shortKrylovSpace K (mark (history (AmbientPairHistory.seed (BlockSpace K) (markedActionCount t) p)))
        node (markedQueryDepth t (plan.authorizationTrace t transcript) 0 i) ⊔
        multiStartKrylovSpace K node (AmbientPairHistory.starts (BlockSpace K) (markedActionCount t) p) := by
  let A := continuousDiagonal K node
  let program := plan.compile A t mark hm
  let u := mark (history (AmbientPairHistory.seed (BlockSpace K) (markedActionCount t) p))
  let N := multiStartKrylovSpace K node (AmbientPairHistory.starts (BlockSpace K) (markedActionCount t) p)
  have hlegal := plan.ambientLegal d t A mark hm F history (fun _ => ⊥)
    p hsupport (by rw [hknown]) hgood
  have hp := program.directAmbient_prefixQueries d (markedActionCount t)
    (plan.ambientOperations A d t mark hm F history p) A.toLinearMap u 0 F history (fun _ => ⊥) N p
    hsupport (by rw [hknown]) bot_le (map_multiStartKrylovSpace_le K node _)
    (AmbientPairHistory.allIn_multiStart K node _ p) hlegal hgood
  rw [plan.ambientOperations_eq] at hp
  dsimp only
  intro i
  rw [shortKrylovSpace_eq_powerKrylovSpace]
  exact plan.query_mem_of_prefixQueries t A mark hm u N _ 0 _ hp i

end RandomizedFO2003.Rotations
