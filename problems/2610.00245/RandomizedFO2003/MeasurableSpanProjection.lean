import Mathlib.Analysis.InnerProductSpace.GramSchmidtOrtho
import Mathlib.MeasureTheory.Function.SpecialFunctions.Inner
import Mathlib.MeasureTheory.Function.SpecialFunctions.Basic

namespace RandomizedFO2003

open MeasureTheory
open scoped BigOperators

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {T : ℕ}

/-- The formula remains valid for dependent and zero generators: division by
zero in a vanishing Gram-Schmidt summand contributes the zero vector. -/
theorem span_projection_gramSchmidt [FiniteDimensional ℝ E] (f : Fin T → E) (x : E) :
    ((Submodule.span ℝ (Set.range f)).orthogonalProjection x : E) =
      ∑ i, (inner (𝕜 := ℝ) (gramSchmidt ℝ f i) x / ‖gramSchmidt ℝ f i‖ ^ 2) •
        gramSchmidt ℝ f i := by
  classical
  rw [← span_gramSchmidt ℝ f]
  apply Submodule.eq_orthogonalProjection_of_mem_of_inner_eq_zero
  · exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
  · intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨i, rfl⟩ := hw
      rw [inner_sub_left, sum_inner]
      have hsum : (∑ j, inner (𝕜 := ℝ)
          ((inner (𝕜 := ℝ) (gramSchmidt ℝ f j) x / ‖gramSchmidt ℝ f j‖ ^ 2) •
            gramSchmidt ℝ f j) (gramSchmidt ℝ f i)) =
          inner (𝕜 := ℝ) x (gramSchmidt ℝ f i) := by
        rw [Finset.sum_eq_single i]
        · rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
          by_cases hi : gramSchmidt ℝ f i = 0
          · simp [hi]
          · rw [div_mul_cancel₀ _ (pow_ne_zero _ (norm_ne_zero_iff.mpr hi)), real_inner_comm]
        · intro j _ hji
          rw [real_inner_smul_left, gramSchmidt_orthogonal ℝ f hji, mul_zero]
        · simp
      rw [hsum, sub_self]
    | zero => exact inner_zero_right _
    | add y z _ _ hy hz => rw [inner_add_right, hy, hz, add_zero]
    | smul a y _ hy => rw [real_inner_smul_right, hy, mul_zero]

variable {Ω : Type*} [MeasurableSpace Ω]
variable [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]

theorem measurable_gramSchmidt (f : Ω → Fin T → E)
    (hf : ∀ i, Measurable (fun ω => f ω i)) (i : Fin T) :
    Measurable (fun ω => gramSchmidt ℝ (f ω) i) := by
  classical
  induction i using (wellFounded_lt (α := Fin T)).induction with
  | h i ih =>
    have heq : (fun ω => gramSchmidt ℝ (f ω) i) = fun ω => f ω i -
        ∑ j ∈ Finset.Iio i,
          (inner (𝕜 := ℝ) (gramSchmidt ℝ (f ω) j) (f ω i) /
            ‖gramSchmidt ℝ (f ω) j‖ ^ 2) • gramSchmidt ℝ (f ω) j := by
      funext ω
      rw [gramSchmidt_def]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [Submodule.orthogonalProjection_singleton]
      simp
    rw [heq]
    apply (hf i).sub
    apply Finset.measurable_sum
    intro j hj
    have hm := ih j (Finset.mem_Iio.mp hj)
    exact ((hm.inner (hf i)).div (hm.norm.pow_const 2)).smul hm

/-- Orthogonal projection onto a span generated by finitely many measurable
vectors is jointly measurable, without a constant-rank assumption. -/
theorem measurable_span_projection [FiniteDimensional ℝ E]
    (f : Ω → Fin T → E) (hf : ∀ i, Measurable (fun ω => f ω i))
    (x : Ω → E) (hx : Measurable x) :
    Measurable (fun ω =>
      ((Submodule.span ℝ (Set.range (f ω))).orthogonalProjection (x ω) : E)) := by
  simp_rw [span_projection_gramSchmidt]
  apply Finset.measurable_sum
  intro i _
  have hm := measurable_gramSchmidt f hf i
  exact ((hm.inner hx).div (hm.norm.pow_const 2)).smul hm

end RandomizedFO2003
