import GradientHessian.ControllerMeasurableExecution
import GradientHessian.ControllerRepairEvents

/-! Measurability of actual chronological repair charges and action
events along any finite list of measurable selected points. The states
are generated by the executable serve transition at each point. -/

noncomputable section
namespace GradientHessian.ControllerMeasurable
open Classical TaskState ComparisonController ComparisonControllerLedger ControllerRepairEvents

variable {Ω X A : Type*} {L M ell : ℕ}
variable [MeasurableSpace Ω] [MeasurableSpace X] [Fintype A]
  [MeasurableSpace A] [MeasurableSingletonClass A]
variable (priority : List A) (target : A → FrontierState.Node L)
  (trigger : Ω → State L M ell → X → A → Bool) (hit : Ω → State L M ell → X → Bool)
  (htrigger : ∀ s a, Measurable (fun p : Ω × X => trigger p.1 s p.2 a))
  (hhit : ∀ s, Measurable (fun p : Ω × X => hit p.1 s p.2))

def traceCharge (target : A → FrontierState.Node L) (tr : List (State L M ell × A)) : ℕ :=
  (tr.map (fun frame => charge frame.1 (FrontierState.subtree (target frame.2)))).sum

omit [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem traceCharge_measurable : Measurable (traceCharge (M := M) (ell := ell) target) :=
  measurable_of_countable _

omit [MeasurableSpace Ω] [MeasurableSpace X] [Fintype A]
  [MeasurableSpace A] [MeasurableSingletonClass A] in
theorem repairs_function_eq_traceCharge (p : Ω → Pending X) (s : Ω → State L M ell) :
    (fun w => repairs (parameterRules priority target trigger hit w) (p w) (s w)) =
      traceCharge target ∘ Prod.snd ∘ (fun w =>
        repairRun (parameterRules priority target trigger hit w) (p w) (8^L) (s w)) := rfl

include htrigger hhit in
theorem serve_along_measurable (p : Ω → Pending X) (hp : Measurable p)
    (s : Ω → State L M ell) (hs : Measurable s) :
    Measurable (fun w => serve (parameterRules priority target trigger hit w) (p w) (s w)) :=
  (serve_joint_measurable priority target trigger hit htrigger hhit).comp
    ((measurable_id.prodMk hp).prodMk hs)

include htrigger in
theorem repairs_along_measurable (p : Ω → Pending X) (hp : Measurable p)
    (s : Ω → State L M ell) (hs : Measurable s) :
    Measurable (fun w => repairs (parameterRules priority target trigger hit w) (p w) (s w)) := by
  have hr : Measurable (fun w =>
      repairRun (parameterRules priority target trigger hit w) (p w) (8^L) (s w)) :=
    (repairRun_joint_measurable priority target trigger hit htrigger (8^L)).comp
    ((measurable_id.prodMk hp).prodMk hs)
  rw [repairs_function_eq_traceCharge]
  exact (traceCharge_measurable target).comp (measurable_snd.comp hr)

include htrigger hhit in
theorem repair_tally_measurable (ps : List (Ω → Pending X))
    (hps : ∀ p ∈ ps, Measurable p) (s : Ω → State L M ell) (hs : Measurable s) :
    Measurable (fun w => tally (parameterRules priority target trigger hit w)
      (repairs (parameterRules priority target trigger hit w)) (ps.map (fun p => p w)) (s w)) := by
  induction ps generalizing s with
  | nil => exact measurable_const
  | cons p ps ih =>
    have hp := hps p List.mem_cons_self
    have hr := serve_along_measurable priority target trigger hit htrigger hhit p hp s hs
    have ha := measurable_receipt_afterNormal.comp hr
    exact (repairs_along_measurable priority target trigger hit htrigger p hp s hs).add
      (ih (fun q hq => hps q (List.mem_cons_of_mem p hq)) _ ha)

include htrigger in
theorem point_action_event_measurable (p : Ω → Pending X) (hp : Measurable p)
    (s : Ω → State L M ell) (hs : Measurable s) (fuel : ℕ) (a : A) :
    MeasurableSet {w | a ∈ pointActions (parameterRules priority target trigger hit w) (p w) fuel (s w)} := by
  have hr := (repairRun_joint_measurable priority target trigger hit htrigger fuel).comp
    ((measurable_id.prodMk hp).prodMk hs)
  have he := (measurable_of_countable (fun tr : List (State L M ell × A) =>
    decide (a ∈ tr.map Prod.snd))).comp (measurable_snd.comp hr)
  have hset := (measurableSet_singleton true).preimage he
  convert hset using 1
  ext w
  simp only [Set.mem_setOf_eq,Set.mem_preimage,Set.mem_singleton_iff,
    Function.comp_apply,decide_eq_true_eq,pointActions,id_eq]

include htrigger hhit in
theorem action_event_measurable (ps : List (Ω → Pending X))
    (hps : ∀ p ∈ ps, Measurable p) (s : Ω → State L M ell) (hs : Measurable s) (a : A) :
    MeasurableSet {w | a ∈ actions (parameterRules priority target trigger hit w)
      (ps.map (fun p => p w)) (s w)} := by
  induction ps generalizing s with
  | nil => simp [actions]
  | cons p ps ih =>
    have hp := hps p List.mem_cons_self
    have hr := serve_along_measurable priority target trigger hit htrigger hhit p hp s hs
    have ha := measurable_receipt_afterNormal.comp hr
    have ht := ih (fun q hq => hps q (List.mem_cons_of_mem p hq)) _ ha
    have hfirst := point_action_event_measurable priority target trigger hit htrigger p hp s hs (8^L) a
    simpa only [List.map_cons,actions,List.mem_append,Set.setOf_or] using hfirst.union ht

end GradientHessian.ControllerMeasurable
