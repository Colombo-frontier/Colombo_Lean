import LowRank.GaussianOracleTranscript
import Mathlib.Probability.ConditionalExpectation

/-! The conditioning sigma-field here is generated by the actual seed and
Gram-oracle replies. Visible factors are measurable in precisely that field,
and the residual Gaussian law is constant under that conditioning. -/

namespace LowRank
open MeasureTheory ProbabilityTheory
open scoped Matrix
noncomputable section

theorem gramOracle_visible_measurable_transcript (r s n : ℕ) {S : Type*} [MeasurableSpace S]
    (policy : VisibleOraclePolicy (r + n) r n 0 S) :
    Measurable[MeasurableSpace.comap (fun p => (runGramOracle r s n policy p).1) inferInstance]
      (fun p => (runGramOracle r s n policy p).2) := by
  let T := fun p => (runGramOracle r s n policy p).1
  let init := fun _ : S => visibleFactorData (initialFactorData (r + n) (s + n))
  have heq : (fun p => (runGramOracle r s n policy p).2) =
      (replayVisibleFactors (r + n) r n 0 policy init) ∘ T := by
    funext p
    exact runVisibleOracle_replay (r + n) r n 0 policy init (p.2 * p.2ᵀ) p.1
  rw [heq]
  exact (measurable_replayVisibleFactors (r + n) r n 0 policy init measurable_const).comp
    (comap_measurable T)

theorem gramOracle_conditional_test (r s n : ℕ) {S : Type*} [MeasurableSpace S]
    (ν : Measure S) [IsProbabilityMeasure ν] (policy : VisibleOraclePolicy (r + n) r n 0 S)
    (hunit : VisibleOraclePolicy.IsUnit (r + n) r n 0 policy) {v : NNReal} (hv : v ≠ 0)
    (φ : Matrix (Fin r) (Fin s) ℝ → ℝ) (hφ : Measurable φ)
    (hφint : Integrable φ (iidMatrixLaw r s v)) :
    let μ := ν.prod (iidMatrixLaw (r + n) (s + n) v)
    let T := fun p => (runGramOracle r s n policy p).1
    let R := gramOracleResidual r s n policy
    Integrable (φ ∘ R) μ ∧
      μ[φ ∘ R | MeasurableSpace.comap T inferInstance] =ᵐ[μ]
        (fun _ => ∫ D, φ D ∂iidMatrixLaw r s v) := by
  let μ := ν.prod (iidMatrixLaw (r + n) (s + n) v)
  let T := fun p => (runGramOracle r s n policy p).1
  let R := gramOracleResidual r s n policy
  change Integrable (φ ∘ R) μ ∧ _
  have hT : Measurable T := (measurable_runGramOracle r s n policy).fst
  have hR : Measurable R :=
    (runGaussianPolicy_preserving r s n ν (compileGramOracle r s n policy) v).measurable.snd
  have hRlaw : MeasurePreserving R μ (iidMatrixLaw r s v) :=
    ⟨hR, gramOracle_residual_law r s n ν policy v⟩
  refine ⟨(hRlaw.integrable_comp hφ.stronglyMeasurable.aestronglyMeasurable).mpr hφint, ?_⟩
  have hind : IndepFun R T μ :=
    ((gramOracle_transcript_residual_independent r s n ν policy hunit hv).comp
      measurable_fst measurable_id).symm
  have hsm : StronglyMeasurable[(inferInstance : MeasurableSpace (Matrix (Fin r) (Fin s) ℝ)).comap R]
      (φ ∘ R) := (hφ.comp (comap_measurable R)).stronglyMeasurable
  have hcond := condExp_indep_eq hR.comap_le hT.comap_le hsm
    ((IndepFun_iff_Indep R T μ).mp hind)
  have hint : (∫ p, φ (R p) ∂μ) = ∫ D, φ D ∂iidMatrixLaw r s v := by
    rw [← hRlaw.map_eq, integral_map_of_stronglyMeasurable hR hφ.stronglyMeasurable]
  simpa only [Function.comp_def, hint] using hcond

/-- The bounded Borel test-function formulation in the manuscript, now for
the actual oracle transcript of a visible unit-direction policy. -/
theorem gramOracle_conditional_bounded (r s n : ℕ) {S : Type*} [MeasurableSpace S]
    (ν : Measure S) [IsProbabilityMeasure ν] (policy : VisibleOraclePolicy (r + n) r n 0 S)
    (hunit : VisibleOraclePolicy.IsUnit (r + n) r n 0 policy) {v : NNReal} (hv : v ≠ 0)
    (φ : Matrix (Fin r) (Fin s) ℝ → ℝ) (hφ : Measurable φ)
    (C : ℝ) (hbound : ∀ D, ‖φ D‖ ≤ C) :
    let μ := ν.prod (iidMatrixLaw (r + n) (s + n) v)
    let T := fun p => (runGramOracle r s n policy p).1
    μ[φ ∘ gramOracleResidual r s n policy | MeasurableSpace.comap T inferInstance] =ᵐ[μ]
      (fun _ => ∫ D, φ D ∂iidMatrixLaw r s v) := by
  have hφint : Integrable φ (iidMatrixLaw r s v) :=
    (integrable_const C).mono' hφ.stronglyMeasurable.aestronglyMeasurable
      (Filter.Eventually.of_forall hbound)
  exact (gramOracle_conditional_test r s n ν policy hunit hv φ hφ hφint).2

end
end LowRank
