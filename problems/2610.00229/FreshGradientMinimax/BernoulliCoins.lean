import FreshGradientMinimax.BernoulliKernel
import FreshGradientMinimax.Algorithm

/-! Finite independent Bernoulli words, generated by a fresh product factor
at every step. No adaptive query enters their distribution. -/

set_option autoImplicit false
noncomputable section
namespace FreshGradientMinimax
open MeasureTheory ProbabilityTheory
open scoped BigOperators

def coinLaw (p : ℝ) : Measure Bool :=
  ENNReal.ofReal p • Measure.dirac true + ENNReal.ofReal (1 - p) • Measure.dirac false

instance coinLaw_finite (p : ℝ) : IsFiniteMeasure (coinLaw p) := by
  constructor
  simp [coinLaw]

theorem coinLaw_probability {p : ℝ} (hp : 0 ≤ p) (hp1 : p ≤ 1) : IsProbabilityMeasure (coinLaw p) := by
  have h := bernoulliKernel_markov hp hp1 (fun _ : Unit => true) (fun _ => false)
    measurable_const measurable_const
  exact h.isProbabilityMeasure ()

def coinSnoc (n : ℕ) (z : (Fin n → Bool) × Bool) : Fin (n + 1) → Bool := Fin.snoc z.1 z.2

theorem coinSnoc_measurable (n : ℕ) : Measurable (coinSnoc n) := measurable_of_countable _

def coinWordLaw (p : ℝ) : (n : ℕ) → Measure (Fin n → Bool)
  | 0 => Measure.dirac Fin.elim0
  | n + 1 => ((coinWordLaw p n).prod (coinLaw p)).map (coinSnoc n)

instance coinWordLaw_finite (p : ℝ) (n : ℕ) : IsFiniteMeasure (coinWordLaw p n) := by
  induction n with
  | zero => exact inferInstanceAs (IsFiniteMeasure (Measure.dirac Fin.elim0))
  | succ n ih =>
    letI := ih
    change IsFiniteMeasure (((coinWordLaw p n).prod (coinLaw p)).map (coinSnoc n))
    infer_instance

theorem coinWordLaw_probability {p : ℝ} (hp : 0 ≤ p) (hp1 : p ≤ 1) (n : ℕ) :
    IsProbabilityMeasure (coinWordLaw p n) := by
  letI := coinLaw_probability hp hp1
  induction n with
  | zero => exact inferInstanceAs (IsProbabilityMeasure (Measure.dirac Fin.elim0))
  | succ n ih =>
    letI := ih
    exact isProbabilityMeasure_map (coinSnoc_measurable n).aemeasurable

theorem coinLaw_map {R : Type*} [MeasurableSpace R] (p : ℝ) (f : Bool → R) :
    (coinLaw p).map f = ENNReal.ofReal p • Measure.dirac (f true) +
      ENNReal.ofReal (1 - p) • Measure.dirac (f false) := by
  have hf : Measurable f := measurable_of_countable _
  rw [coinLaw, Measure.map_add _ _ hf]
  simp only [Measure.map_smul, Measure.map_dirac hf]

theorem coinWordLaw_rectangle (p : ℝ) (n : ℕ) (s : Fin n → Set Bool)
    (hs : ∀ i, MeasurableSet (s i)) :
    coinWordLaw p n (Set.pi Set.univ s) = ∏ i, coinLaw p (s i) := by
  induction n with
  | zero => simp [coinWordLaw]
  | succ n ih =>
    have he : coinSnoc n ⁻¹' Set.pi Set.univ s =
        (Set.pi Set.univ (fun i : Fin n => s i.castSucc)) ×ˢ s (Fin.last n) := by
      ext z
      simp only [Set.mem_preimage, Set.mem_pi, Set.mem_univ, forall_true_left, Set.mem_prod]
      constructor
      · intro h
        exact ⟨fun i => by simpa only [coinSnoc, Fin.snoc_castSucc] using h i.castSucc,
          by simpa only [coinSnoc, Fin.snoc_last] using h (Fin.last n)⟩
      · rintro ⟨h, hc⟩ i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · simpa only [coinSnoc, Fin.snoc_last] using hc
        · simpa only [coinSnoc, Fin.snoc_castSucc] using h j
    rw [coinWordLaw, Measure.map_apply (coinSnoc_measurable n) (MeasurableSet.univ_pi hs), he,
      Measure.prod_prod, ih _ (fun i => hs i.castSucc), Fin.prod_univ_castSucc]

theorem coinWordLaw_eq_pi (p : ℝ) (n : ℕ) :
    coinWordLaw p n = Measure.pi (fun _ : Fin n => coinLaw p) :=
  (Measure.pi_eq (coinWordLaw_rectangle p n)).symm

theorem bernoulliKernel_eq_coin_map {Q R : Type*} [MeasurableSpace Q] [MeasurableSpace R]
    (p : ℝ) (a b : Q → R) (ha : Measurable a) (hb : Measurable b) (q : Q) :
    bernoulliKernel p a b ha hb q = (coinLaw p).map (fun c => if c then a q else b q) := by
  rw [coinLaw_map]
  rfl

end FreshGradientMinimax
