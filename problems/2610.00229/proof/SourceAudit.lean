    | some (.thmInfo _) => pure ()
    | _ => throwError "Missing or non-theorem declaration: {name}"
  let collectAll : CollectAxioms.M Unit := names.forM CollectAxioms.collect
  let (_, state) := (collectAll.run env).run {}
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  for axiomName in state.axioms do
    unless allowed.contains axiomName do
      throwError "Unexpected axiom: {axiomName}"
