import LeanArticleAudit.Pilot.JetMeasurability

/-!
# Canonical executable randomized lower-bound instance

This module packages the measurable truncated-oracle runner into the
dependent stopped history required by `BorelRandomExecution`.
-/

open Set MeasureTheory
open scoped RealInnerProductSpace ContDiff

namespace LeanArticleAudit.Pilot

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A componentwise measurable simulation has a jointly measurable slab
event.  This is the event used by Fubini; no measurability of the residual is
needed. -/
theorem measurableSet_jointRandomSlabEvent
    {Seed : Type*} [MeasurableSpace Seed]
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (sim : Seed → FixedSeedSimulation prior)
    (hquery : ∀ (t i : Fin N), Measurable (fun z : prior.Omega × Seed =>
      inner ℝ (prior.frame z.1 i.castSucc) ((sim z.2).query t z.1)))
    (houtput : Measurable (fun z : prior.Omega × Seed =>
      inner ℝ (prior.frame z.1 (Fin.last N)) ((sim z.2).output z.1))) :
    MeasurableSet {z : prior.Omega × Seed |
      z.1 ∈ randomSlabEvent prior (sim z.2)} := by
  rw [show {z : prior.Omega × Seed |
      z.1 ∈ randomSlabEvent prior (sim z.2)} =
      ⋂ idx : RandomSlabIndex N,
        {z | z.1 ∈ randomSlabGood prior (sim z.2) idx} by
    ext z
    simp [randomSlabEvent, allGoodEvent]]
  apply MeasurableSet.iInter
  intro idx
  cases idx with
  | inl pair =>
      rcases pair with ⟨t, i⟩
      simp only [randomSlabGood]
      split
      · exact measurableSet_Iic.preimage (hquery t i).abs
      · exact MeasurableSet.univ
  | inr _ =>
      simp only [randomSlabGood]
      exact measurableSet_Iic.preimage houtput.abs

section Canonical

variable [FiniteDimensional ℝ E] [Nontrivial E]
  [MeasurableSpace E] [BorelSpace E]

/-- Joint measurability of the slab event generated by the canonical
truncated-hidden-operator runner. -/
theorem measurableSet_canonicalRunner_jointRandomSlabEvent
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (p : ℕ) (hp : 2 ≤ p) (profile : GateProfile)
    (Lp : ℝ) (hLp : 0 < Lp) (hR : 0 < R)
    (hframe : Measurable prior.frame)
    (policy : BorelStoppingPolicy
      (Answer := SymmetricExactJet E p) (Metric.closedBall (0 : E) R) N)
    (fill : Metric.closedBall (0 : E) R) (dummy : SymmetricExactJet E p) :
    @MeasurableSet (prior.Omega × policy.Seed)
      (MeasurableSpace.prod prior.measurableSpace policy.seedMeasurable)
      {z : prior.Omega × policy.Seed | z.1 ∈ randomSlabEvent prior
        (canonicalRunnerFixedSeedSimulation prior p hp profile Lp hLp hR
          hframe policy fill dummy z.2)} := by
  letI := policy.seedMeasurable
  let stageOracle := fun omega t x =>
    (truncatedHiddenExactOracle p hp profile Lp hLp R hR N t
      (prior.frame omega)).answer x
  have hrunner : BorelStoppingPolicy.JointlyMeasurableRunner policy
      stageOracle fill dummy :=
    canonicalTruncatedHiddenJointlyMeasurableRunner
      p hp profile Lp hLp R hR N prior.frame hframe policy fill dummy
  apply measurableSet_jointRandomSlabEvent prior
    (fun seed => canonicalRunnerFixedSeedSimulation prior p hp profile Lp hLp hR
      hframe policy fill dummy seed)
  · intro t i
    change Measurable (fun z : prior.Omega × policy.Seed =>
      inner ℝ (prior.frame z.1 i.castSucc)
        ((BorelStoppingPolicy.runnerQuery policy stageOracle fill dummy t z).1))
    have hf : Measurable (fun z : prior.Omega × policy.Seed =>
        prior.frame z.1 i.castSucc) :=
      ((measurable_pi_apply i.castSucc).comp hframe).comp measurable_fst
    have hq : Measurable (fun z : prior.Omega × policy.Seed =>
        (BorelStoppingPolicy.runnerQuery policy stageOracle fill dummy t z).1) :=
      measurable_subtype_coe.comp (hrunner.query_joint t)
    fun_prop
  · change Measurable (fun z : prior.Omega × policy.Seed =>
      inner ℝ (prior.frame z.1 (Fin.last N))
        ((BorelStoppingPolicy.runnerOutput policy stageOracle fill dummy z).1))
    have hf : Measurable (fun z : prior.Omega × policy.Seed =>
        prior.frame z.1 (Fin.last N)) :=
      ((measurable_pi_apply (Fin.last N)).comp hframe).comp measurable_fst
    have ho : Measurable (fun z : prior.Omega × policy.Seed =>
        (BorelStoppingPolicy.runnerOutput policy stageOracle fill dummy z).1) :=
      measurable_subtype_coe.comp hrunner.output_joint
    fun_prop

/-- Run the policy against one fixed final hidden operator at every stage.
Unlike the truncated simulation, this is the algorithm's actual output for
every frame and seed, not merely on the slab event. -/
noncomputable def actualHiddenRunnerOutput
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (p : ℕ) (hp : 2 ≤ p) (profile : GateProfile)
    (Lp : ℝ) (hLp : 0 < Lp) (hR : 0 < R)
    (policy : BorelStoppingPolicy
      (Answer := SymmetricExactJet E p) (Metric.closedBall (0 : E) R) N)
    (fill : Metric.closedBall (0 : E) R) (dummy : SymmetricExactJet E p)
    (omega : prior.Omega) (seed : policy.Seed) :
    Metric.closedBall (0 : E) R :=
  BorelStoppingPolicy.runnerOutput policy
    (fun omega _t x =>
      (finalHiddenExactOracle p hp profile Lp hLp R hR N
        (prior.frame omega)).answer x)
    fill dummy (omega, seed)

/-- `actualHiddenRunnerOutput` is saved by a genuine unpadded policy run
against the final fixed hidden exact oracle, for every frame and seed. -/
theorem actualHiddenRunnerOutput_isUnpaddedRun
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (p : ℕ) (hp : 2 ≤ p) (profile : GateProfile)
    (Lp : ℝ) (hLp : 0 < Lp) (hR : 0 < R)
    (policy : BorelStoppingPolicy
      (Answer := SymmetricExactJet E p) (Metric.closedBall (0 : E) R) N)
    (fill : Metric.closedBall (0 : E) R) (dummy : SymmetricExactJet E p)
    (omega : prior.Omega) (seed : policy.Seed) :
    ∃ n, ∃ hn : n ≤ N,
      ∃ history : OracleHistory (Metric.closedBall (0 : E) R)
          (SymmetricExactJet E p) n,
        policy.IsUnpaddedRun
          (finalHiddenExactOracle p hp profile Lp hLp R hR N
            (prior.frame omega)).answer
          seed n hn history
          (actualHiddenRunnerOutput prior p hp profile Lp hLp hR
            policy fill dummy omega seed) := by
  let finalStage := fun omega (_t : Fin N) x =>
    (finalHiddenExactOracle p hp profile Lp hLp R hR N
      (prior.frame omega)).answer x
  obtain ⟨n, hn, _hcount, hrun⟩ :=
    BorelStoppingPolicy.runner_executes_unpadded_stage
      policy finalStage fill dummy (omega, seed)
  refine ⟨n, hn, OracleHistory.restrict
    (BorelStoppingPolicy.runnerHistory policy finalStage fill dummy (omega, seed))
    hn, ?_⟩
  have hfixed := hrun.to_fixedOracle (fun _i => rfl)
  simpa only [actualHiddenRunnerOutput, finalStage] using hfixed

/-- On the joint slab event, the truncated simulation and the genuine final
oracle runner see identical answers at every query and therefore save the same
output. -/
theorem actualHiddenRunnerOutput_eq_simulated_on_slab
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (p : ℕ) (hp : 2 ≤ p) (profile : GateProfile)
    (Lp : ℝ) (hLp : 0 < Lp) (hR : 0 < R)
    (hframe : Measurable prior.frame)
    (policy : BorelStoppingPolicy
      (Answer := SymmetricExactJet E p) (Metric.closedBall (0 : E) R) N)
    (fill : Metric.closedBall (0 : E) R) (dummy : SymmetricExactJet E p)
    (omega : prior.Omega) (seed : policy.Seed)
    (hslab : omega ∈ randomSlabEvent prior
      (canonicalRunnerFixedSeedSimulation prior p hp profile Lp hLp hR
        hframe policy fill dummy seed)) :
    actualHiddenRunnerOutput prior p hp profile Lp hLp hR
        policy fill dummy omega seed =
      BorelStoppingPolicy.runnerOutput policy
        (fun omega t x =>
          (truncatedHiddenExactOracle p hp profile Lp hLp R hR N t
            (prior.frame omega)).answer x)
        fill dummy (omega, seed) := by
  let truncatedStage := fun omega t x =>
    (truncatedHiddenExactOracle p hp profile Lp hLp R hR N t
      (prior.frame omega)).answer x
  let finalStage := fun omega (_t : Fin N) x =>
    (finalHiddenExactOracle p hp profile Lp hLp R hR N
      (prior.frame omega)).answer x
  have hanswer : ∀ t : Fin N,
      truncatedStage omega t
          (BorelStoppingPolicy.runnerQuery policy truncatedStage fill dummy
            t (omega, seed)).1 =
        finalStage omega t
          (BorelStoppingPolicy.runnerQuery policy truncatedStage fill dummy
            t (omega, seed)).1 := by
    intro t
    let x := (BorelStoppingPolicy.runnerQuery policy truncatedStage fill dummy
      t (omega, seed)).1
    have hjet := truncatedHiddenOperator_fullJetCoupledAt_of_slab
      p profile Lp hR N t.1 (prior.frame omega) x
      (fun i hi => randomSlabEvent_query_slab
        (canonicalRunnerFixedSeedSimulation prior p hp profile Lp hLp hR
          hframe policy fill dummy seed) hslab t i hi)
    have hans :=
      (truncatedHiddenExactOracle p hp profile Lp hLp R hR N t
        (prior.frame omega)).answer_eq_of_fullJetCoupledAt
          (finalHiddenExactOracle p hp profile Lp hLp R hR N
            (prior.frame omega)) hjet
    simpa only [truncatedStage, finalStage, x,
      canonicalRunnerFixedSeedSimulation] using hans
  have hout := BorelStoppingPolicy.runnerOutput_eq_of_answerAtRunnerQuery
    policy truncatedStage finalStage fill dummy (omega, seed) hanswer
  simpa only [actualHiddenRunnerOutput, truncatedStage, finalStage] using hout.symm

/-- The canonical measurable runner, saved dependent prefix, and canonical
truncated/final exact oracles form a concrete `BorelRandomExecution`.

The stopped history is a restriction of the fixed-cap representation.  Thus
the suffix used for concentration is only padding and is never interpreted as
an oracle call after the policy stops. -/
noncomputable def canonicalBorelRandomExecution
    {N d : ℕ} {R : ℝ} (prior : SequentialFramePrior E N d R)
    (p : ℕ) (hp : 2 ≤ p) (profile : GateProfile)
    (Lp : ℝ) (hLp : 0 < Lp) (hR : 0 < R)
    (hframe : Measurable prior.frame)
    (policy : BorelStoppingPolicy
      (Answer := SymmetricExactJet E p) (Metric.closedBall (0 : E) R) N)
    (fill : Metric.closedBall (0 : E) R) (dummy : SymmetricExactJet E p) :
    BorelRandomExecution prior p hp profile Lp hLp hR policy := by
  let stageAnswer := fun omega t x =>
    (truncatedHiddenExactOracle p hp profile Lp hLp R hR N t
      (prior.frame omega)).answer x
  let stop := fun omega seed =>
    BorelStoppingPolicy.runnerStoppedAt policy stageAnswer fill dummy (omega, seed)
  have hstop : ∀ omega seed, stop omega seed ≤ N := by
    intro omega seed
    obtain ⟨n, hn, hcount, _⟩ :=
      BorelStoppingPolicy.runner_executes_unpadded_stage
        policy stageAnswer fill dummy (omega, seed)
    dsimp [stop]
    rw [← hcount]
    exact hn
  refine
    { simulation := fun seed => canonicalRunnerFixedSeedSimulation prior p hp profile
        Lp hLp hR hframe policy fill dummy seed
      stageOracle := fun omega t => truncatedHiddenExactOracle p hp profile Lp hLp
        R hR N t (prior.frame omega)
      actualOracle := fun omega => finalHiddenExactOracle p hp profile Lp hLp
        R hR N (prior.frame omega)
      stoppedAt := stop
      stoppedAt_le := hstop
      history := fun omega seed => OracleHistory.restrict
        (BorelStoppingPolicy.runnerHistory policy stageAnswer fill dummy (omega, seed))
        (hstop omega seed)
      output := fun omega seed =>
        BorelStoppingPolicy.runnerOutput policy stageAnswer fill dummy (omega, seed)
      actualOutput := fun omega seed => actualHiddenRunnerOutput prior p hp profile
        Lp hLp hR policy fill dummy omega seed
      stage_run := ?_
      history_query_eq := ?_
      output_eq := ?_
      actual_run := ?_
      actualOutput_eq_on_slab := ?_
      joint_slab_measurable := ?_ }
  · intro omega seed
    obtain ⟨n, hn, hcount, hrun⟩ :=
      BorelStoppingPolicy.runner_executes_unpadded_stage
        policy stageAnswer fill dummy (omega, seed)
    subst n
    simpa only using hrun
  · intro omega seed i
    let t : Fin N := ⟨i.1, Nat.lt_of_lt_of_le i.2 (hstop omega seed)⟩
    have hq := BorelStoppingPolicy.runnerHistory_query_eq_runnerQuery
      policy stageAnswer fill dummy t (omega, seed)
    have hqv := congrArg Subtype.val hq
    simpa only [OracleHistory.restrict, t, stageAnswer,
      canonicalRunnerFixedSeedSimulation] using hqv
  · intro omega seed
    rfl
  · intro omega seed
    exact actualHiddenRunnerOutput_isUnpaddedRun prior p hp profile Lp hLp hR
      policy fill dummy omega seed
  · intro omega seed hslab
    exact actualHiddenRunnerOutput_eq_simulated_on_slab prior p hp profile Lp hLp
      hR hframe policy fill dummy omega seed hslab
  · exact measurableSet_canonicalRunner_jointRandomSlabEvent prior p hp profile
      Lp hLp hR hframe policy fill dummy

end Canonical

end LeanArticleAudit.Pilot
