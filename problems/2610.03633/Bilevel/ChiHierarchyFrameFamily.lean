import Bilevel.ChiHierarchyHaar
import Bilevel.ChiHierarchyLookup

/-! Total source-indexed frames generated by the finite prior. Every legal
node reads its own independent orientation. Invalid or out-of-depth indices
use a fixed public orientation and introduce no additional randomness. -/
noncomputable section
open MeasureTheory
namespace Bilevel.ChiHierarchyHaar
open ChiHierarchyIndex
set_option maxHeartbeats 600000

def nodeOrientation {counts : ℕ → ℕ} {J D : ℕ} (a : Orientations counts J D)
    (j : ℕ) (I : List ℕ) : OrthogonalHaar.Group D :=
  match lookup counts J j I with
  | none => 1
  | some i => a (Sum.inr i)

theorem nodeOrientation_at_node {counts : ℕ → ℕ} {J D : ℕ} (a : Orientations counts J D)
    (i : Node counts J) : nodeOrientation a i.1.val (nodeList i) = a (Sum.inr i) := by
  simp only [nodeOrientation,lookup_node]

theorem nodeOrientation_measurable {counts : ℕ → ℕ} {J D : ℕ} (j : ℕ) (I : List ℕ) :
    Measurable (fun a : Orientations counts J D => nodeOrientation a j I) := by
  unfold nodeOrientation
  cases lookup counts J j I with
  | none => exact measurable_const
  | some i => exact measurable_pi_apply (Sum.inr i)

theorem lookup_none_of_depth {counts : ℕ → ℕ} {J j : ℕ} (hj : J < j) (I : List ℕ) :
    lookup counts J j I = none := by
  cases h : lookup counts J j I with
  | none => rfl
  | some i =>
    have he := (lookup_some_iff.mp h).1
    have hi := i.1.isLt
    omega

theorem nodeOrientation_public_of_depth {counts : ℕ → ℕ} {J D j : ℕ}
    (a : Orientations counts J D) (hj : J < j) (I : List ℕ) :
    nodeOrientation a j I = 1 := by
  simp only [nodeOrientation,lookup_none_of_depth hj I]

def sourceFrame {counts : ℕ → ℕ} {J D : ℕ}
    (hD : ∀ j, counts (j+1)+1 ≤ D) (a : Orientations counts J D) (j : ℕ) (I : List ℕ) :
    ChiBoundedChain.Space (counts (j+1)) →ₗᵢ[ℝ] EuclideanGaussian.Space D :=
  (OrthogonalAction.isometry D (nodeOrientation a j I)).toLinearIsometry.comp
    (ChiPrefixEvaluation.auxiliaryFrame (counts (j+1)) D (hD j))

theorem sourceFrame_at_node {counts : ℕ → ℕ} {J D : ℕ}
    (hD : ∀ j, counts (j+1)+1 ≤ D)
    (hAll : ∀ i : FrameIndex counts J, chainSize i+1 ≤ D)
    (a : Orientations counts J D) (i : Node counts J) :
    sourceFrame hD a i.1.val (nodeList i) = frame hAll a (Sum.inr i) := by
  simp only [sourceFrame,nodeOrientation_at_node,frame,chainSize]

theorem sourceFrame_basis {counts : ℕ → ℕ} {J D : ℕ}
    (hD : ∀ j, counts (j+1)+1 ≤ D)
    (hAll : ∀ i : FrameIndex counts J, chainSize i+1 ≤ D)
    (a : Orientations counts J D) (i : Node counts J) (k : Fin (counts (i.1.val+1)+1)) :
    sourceFrame hD a i.1.val (nodeList i) (ChiBoundedChain.basis k) = columns hAll a (Sum.inr i) k := by
  rw [sourceFrame_at_node hD hAll]
  exact frame_basis hAll a (Sum.inr i) k

theorem sourceFrame_apply_measurable {counts : ℕ → ℕ} {J D : ℕ}
    (hD : ∀ j, counts (j+1)+1 ≤ D) (j : ℕ) (I : List ℕ) :
    Measurable (fun p : Orientations counts J D × ChiBoundedChain.Space (counts (j+1)) =>
      sourceFrame hD p.1 j I p.2) := by
  have h : Measurable (fun p : Orientations counts J D × ChiBoundedChain.Space (counts (j+1)) =>
      nodeOrientation p.1 j I) := (nodeOrientation_measurable j I).comp measurable_fst
  have hu : Measurable (fun p : Orientations counts J D × ChiBoundedChain.Space (counts (j+1)) =>
      ChiPrefixEvaluation.auxiliaryFrame (counts (j+1)) D (hD j) p.2) :=
    (ChiPrefixEvaluation.auxiliaryFrame (counts (j+1)) D (hD j)).continuous.measurable.comp measurable_snd
  exact h.smul hu

theorem sourceFrame_column_measurable {counts : ℕ → ℕ} {J D : ℕ}
    (hD : ∀ j, counts (j+1)+1 ≤ D) (j : ℕ) (I : List ℕ)
    (k : Fin (counts (j+1)+1)) :
    Measurable (fun a : Orientations counts J D => sourceFrame hD a j I (ChiBoundedChain.basis k)) := by
  change Measurable (fun a : Orientations counts J D => nodeOrientation a j I •
    ChiPrefixEvaluation.auxiliaryFrame (counts (j+1)) D (hD j) (ChiBoundedChain.basis k))
  exact (nodeOrientation_measurable j I).smul measurable_const

end Bilevel.ChiHierarchyHaar
