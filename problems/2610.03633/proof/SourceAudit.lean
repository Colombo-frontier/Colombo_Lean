import PolishedCertification
import Lean
import Lean.Util.CollectAxioms

/-!
Shared traversal of the official kernel-checked constant graph.  This is an
audit command, not a theorem or a replacement for kernel checking.  Its result
is the conservative union for all requested declarations, not a per-declaration
list.  Every target must already exist in `env.checked.get`.
-/

namespace SharedAxiomAudit

private def dottedName (s : String) : Lean.Name :=
  (s.splitOn ".").foldl Lean.Name.str Lean.Name.anonymous

def audit (targets : Array String) : Lean.Elab.Command.CommandElabM Unit := do
  let env ← Lean.getEnv
  let names := targets.map dottedName
  for n in names do
    if (env.checked.get.find? n).isNone then
      throwError "Shared axiom audit: kernel-checked declaration not found: {n}"
  -- Exactly the official `collectAxioms` traversal, with its state initialized
  -- once instead of once per declaration. `collect` itself reads only checked
  -- constants. A shared visited set cannot omit a dependency from the union.
  let (_, state) := ((names.forM Lean.CollectAxioms.collect).run env).run {}
  let allowed := #[``Classical.choice, ``Quot.sound, ``propext]
  for n in state.axioms do
    unless allowed.contains n do
      throwError "Shared axiom audit: nonstandard axiom dependency: {n}"
  let payload := Lean.Json.mkObj [
    ("audit_kind", Lean.toJson "official_shared_checked_graph_union"),
    ("declarations", Lean.toJson targets),
    ("declaration_count", Lean.toJson targets.size),
    ("axiom_union", Lean.toJson (state.axioms.map Lean.Name.toString))]
  liftM (m := IO) <| IO.println ("SHARED_AXIOM_AUDIT_JSON " ++ payload.compress)

end SharedAxiomAudit

