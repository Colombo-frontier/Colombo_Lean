import RandomizedFO2003.ChronologicalKrylov
import RandomizedFO2003.AmbientProduct

namespace RandomizedFO2003.Rotations

open MeasureTheory SpectralCoordinates

universe u

/-- The nuisance space generated by the actual independent ambient starts
automatically contains every auxiliary and every innovation vector. -/
theorem AmbientPairHistory.allIn_multiStart {J : ℕ} (K : Fin J → ℕ) (node : Fin J → ℝ)
    (n : ℕ) {Ω : Type u} (p : AmbientPairHistory (BlockSpace K) n Ω) :
    AmbientPairHistory.AllIn (BlockSpace K)
      (multiStartKrylovSpace K node (AmbientPairHistory.starts (BlockSpace K) n p)) n p := by
  rw [AmbientPairHistory.allIn_iff_starts]
  exact start_mem_multiStartKrylovSpace K node _

/-- The exact adaptive latent queries satisfy the same short-plus-multiple-start
space bound already used by the high-multiplicity readout theorem. All legality
and chronological degree conditions are explicit. -/
theorem ActionProgram.selectedQueries_spectralKrylov {J : ℕ} (K : Fin J → ℕ)
    (node : Fin J → ℝ) (d n m : ℕ) {H Ω : Type u}
    [MeasurableSpace H] [MeasurableSpace Ω] (plan : ActionProgram (BlockSpace K) n H)
    (ops : Fin n → LatentOperation) (u : BlockSpace K)
    (F : Ω → ExposureFrame (Coordinates (d + n)) (BlockSpace K)) (history : Ω → H)
    (p : AmbientPairHistory (BlockSpace K) n Ω)
    (hsupport : (F (AmbientPairHistory.seed (BlockSpace K) n p)).KnownSupport)
    (hknown : embeddingComplement (F (AmbientPairHistory.seed (BlockSpace K) n p)).latent = ⊥)
    (hlegal : plan.KrylovLegal d (diagonal K node) u n ops F history (fun _ => ⊥) p)
    (hdegree : LatentOperation.finalDepth n ops 0 ≤ m)
    (hgood : plan.directAmbientGood d n F history p) :
    ∀ v ∈ plan.selectQueries n (plan.directAmbientTranscript d n F history p),
      v ∈ shortKrylovSpace K u node m ⊔
        multiStartKrylovSpace K node (AmbientPairHistory.starts (BlockSpace K) n p) := by
  intro v hv
  rw [shortKrylovSpace_eq_powerKrylovSpace]
  apply (sup_le_sup_right (powerKrylovSpace_mono (diagonal K node) u hdegree) _)
  exact plan.selectedQueries_krylov d n ops (diagonal K node) u 0 F history (fun _ => ⊥)
    _ p hsupport (by rw [hknown]) bot_le (map_multiStartKrylovSpace_le K node _)
    (AmbientPairHistory.allIn_multiStart K node n p) hlegal hgood v hv

/-- One full-measure event works for every pathwise authorization schedule and
marked vector satisfying the displayed legality test. Thus adaptation itself
does not introduce a hidden independence assumption. -/
theorem ActionProgram.selectedQueries_ae_spectralKrylov {J : ℕ} (K : Fin J → ℕ)
    (node : Fin J → ℝ) (d n m : ℕ) {H Ω : Type u}
    [MeasurableSpace H] [MeasurableSpace Ω] (μ : Measure Ω) [SFinite μ]
    (plan : ActionProgram (BlockSpace K) n H)
    (F : Ω → ExposureFrame (Coordinates (d + n)) (BlockSpace K))
    (hF : ExposureFrame.MeasurableFamily F) (hsupport : ∀ ω, (F ω).KnownSupport)
    (hknown : ∀ ω, embeddingComplement (F ω).latent = ⊥)
    (history : Ω → H) (hh : Measurable history) :
    ∀ᵐ p ∂ambientPairHistoryLaw (BlockSpace K) n μ,
      ∀ (ops : Fin n → LatentOperation) (u : BlockSpace K),
        plan.KrylovLegal d (diagonal K node) u n ops F history (fun _ => ⊥) p →
        LatentOperation.finalDepth n ops 0 ≤ m →
        ∀ v ∈ plan.selectQueries n (plan.directAmbientTranscript d n F history p),
          v ∈ shortKrylovSpace K u node m ⊔
            multiStartKrylovSpace K node (AmbientPairHistory.starts (BlockSpace K) n p) := by
  filter_upwards [plan.directAmbientGood_ae d n μ F hF history hh] with p hp
  intro ops u hlegal hdegree
  exact plan.selectedQueries_spectralKrylov K node d n m ops u F history p
    (hsupport _) (hknown _) hlegal hdegree hp

end RandomizedFO2003.Rotations
