  -- END PROJECT MODULES
  let env ← getEnv
  for moduleName in projectModules do
    unless env.header.moduleNames.contains moduleName do
      throwError "Missing original module in the audit environment: {moduleName}"
  let mut names : Array Name := #[]
  let mut theoremCount := 0
  let mut definitionCount := 0
  let mut compilerCount := 0
  for (name, info) in env.constants.toList do
    let moduleName := (env.getModuleIdxFor? name |>.map
      (fun i => env.header.moduleNames[i.toNat]!)).getD Name.anonymous
    if projectModules.contains moduleName then
      if info.isUnsafe then
        compilerCount := compilerCount + 1
      else
        names := names.push name
        match info with
        | .thmInfo _ =>
          theoremCount := theoremCount + 1
          unless (env.checked.get.find? name).isSome do
            throwError "Theorem absent from the kernel-checked environment: {name}"
        | .defnInfo _ | .opaqueInfo _ => definitionCount := definitionCount + 1
        | .axiomInfo _ => throwError "Custom unproved project axiom: {name}"
        | _ => pure ()
  if names.isEmpty || theoremCount == 0 then throwError "No project theorems found."
  names := names.qsort (fun a b => a.toString < b.toString)
  let mut closure : Lean.CollectAxioms.State := {}
  for name in names do
    let (_, next) := ((Lean.CollectAxioms.collect name).run env).run closure
    closure := next
    let unexpected := closure.axioms.filter (fun a =>
      a != `propext && a != `Classical.choice && a != `Quot.sound)
    unless unexpected.isEmpty do
      throwError "{name}: unexpected transitive axiom dependencies {unexpected}"
    logInfo m!"DECLARATION AUDITED: {name}"
    match env.find? name with
    | some (.thmInfo _) => logInfo m!"THEOREM AUDITED: {name}"
    | _ => pure ()
  logInfo m!"AXIOM UNION: {closure.axioms}"
  logInfo m!"AUDIT PASSED: {names.size} declarations; {theoremCount} theorems; {definitionCount} logical definitions; standard axioms only."
  logInfo m!"COMPILER ARTIFACTS: {compilerCount} unsafe declarations, unavailable to kernel proofs."
