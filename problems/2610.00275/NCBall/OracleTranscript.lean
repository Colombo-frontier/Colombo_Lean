import NCBall.LinearTranscript

/-! # Scalar histories generated by an oracle on a fixed random environment -/

noncomputable section
open MeasureTheory
namespace NCBall

variable {S Ω : Type*} [MeasurableSpace S]

def oracleTranscript (reply : (t : ℕ) → LinearHistory S t → Ω → ℝ) :
    (t : ℕ) → S × Ω → LinearHistory S t
  | 0, w => w.1
  | t + 1, w =>
      let h := oracleTranscript reply t w
      (h, reply t h w.2)

theorem oracleTranscript_measurable [MeasurableSpace Ω]
    (reply : (t : ℕ) → LinearHistory S t → Ω → ℝ)
    (hr : ∀ t, Measurable (fun hz : LinearHistory S t × Ω => reply t hz.1 hz.2))
    (t : ℕ) : Measurable (oracleTranscript reply t) := by
  induction t with
  | zero => exact measurable_fst
  | succ t ih => exact ih.prodMk ((hr t).comp (ih.prodMk measurable_snd))

omit [MeasurableSpace S] in
theorem oracleTranscript_eq_of_no_bad
    (realReply shadowReply : (t : ℕ) → LinearHistory S t → Ω → ℝ)
    (bad : (t : ℕ) → LinearHistory S t → Ω → Prop)
    (hagree : ∀ t h z, ¬bad t h z → realReply t h z = shadowReply t h z)
    (N : ℕ) (w : S × Ω)
    (hsafe : ∀ t < N, ¬bad t (oracleTranscript shadowReply t w) w.2) :
    ∀ t ≤ N, oracleTranscript realReply t w = oracleTranscript shadowReply t w := by
  intro t
  induction t with
  | zero => intros; rfl
  | succ t ih =>
    intro ht
    simp only [oracleTranscript, ih (by omega)]
    rw [hagree t _ _ (hsafe t (by omega))]

end NCBall
