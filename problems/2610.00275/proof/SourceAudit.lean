  let mut closure : Lean.CollectAxioms.State := {}
  for name in names do
    if (env.find? name).isNone then throwError "Missing source audit endpoint: {name}"
    let (_, next) := ((Lean.CollectAxioms.collect name).run env).run closure
    closure := next
    let unexpected := closure.axioms.filter (fun a =>
      a != `propext && a != `Classical.choice && a != `Quot.sound)
    unless unexpected.isEmpty do
      throwError "{name}: unexpected transitive axioms {unexpected}"
    logInfo m!"PASS {name}: cumulative dependency axioms {closure.axioms}"
  logInfo m!"SOURCE AUDIT PASSED: {names.size} endpoints; standard axioms only."
