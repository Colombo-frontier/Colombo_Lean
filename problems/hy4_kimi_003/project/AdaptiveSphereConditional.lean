import Mathlib

/-!
Conditional symmetry tools for the adaptive-sphere proof.
These results derive conditional moments from actual measure-preserving
transformations fixing the observation sigma-algebra. They do not assume a
terminal posterior-energy estimate. Constructing such transformations for every
arbitrary measurable adaptive transcript is a separate remaining obligation.
-/

open MeasureTheory ProbabilityTheory Set

namespace Task006.AdaptiveSphere

noncomputable section

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]
  {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- A symmetry fixing an observable fixes every event generated by it. -/
theorem comap_event_invariant {H : Type*} [mH : MeasurableSpace H]
    (obs : Ω → H) (e : @MeasurableEquiv Ω Ω mΩ mΩ) (hobs : ∀ ω, obs (e ω) = obs ω)
    {s : Set Ω} (hs : MeasurableSet[mH.comap obs] s) :
    e ⁻¹' s = s := by
  rcases hs with ⟨t, ht, rfl⟩
  ext ω
  simp only [mem_preimage, hobs]

omit [IsProbabilityMeasure μ] in
/-- Change of variables on any observable-invariant event. -/
theorem setIntegral_transport_of_invariant_equiv
    (e : @MeasurableEquiv Ω Ω mΩ mΩ) (he : @MeasurePreserving Ω Ω mΩ mΩ e μ μ)
    (s : Set Ω) (hs : MeasurableSet s) (hinv : e ⁻¹' s = s)
    (f g : Ω → ℝ) (hcomp : ∀ ω, f (e ω) = g ω) :
    ∫ ω in s, g ω ∂μ = ∫ ω in s, f ω ∂μ := by
  have hind : (fun ω => (s.indicator f) (e ω)) = s.indicator g := by
    funext ω
    have hmem : e ω ∈ s ↔ ω ∈ s := by
      change ω ∈ e ⁻¹' s ↔ ω ∈ s
      rw [hinv]
    by_cases hω : ω ∈ s
    · have heω : e ω ∈ s := hmem.mpr hω
      simp only [indicator_of_mem heω, indicator_of_mem hω, hcomp]
    · have heω : e ω ∉ s := fun h => hω (hmem.mp h)
      simp only [indicator_of_notMem heω, indicator_of_notMem hω]
  have hchange := he.integral_comp' (s.indicator f)
  rw [hind, integral_indicator hs, integral_indicator hs] at hchange
  exact hchange

/-- Conditional expectations are transported by a genuine probability-space
symmetry preserving every event in the conditioning sigma-algebra. -/
theorem condExp_transport_of_invariant_equiv
    (m : MeasurableSpace Ω) (hm : m ≤ mΩ)
    (e : @MeasurableEquiv Ω Ω mΩ mΩ) (he : @MeasurePreserving Ω Ω mΩ mΩ e μ μ)
    (hinv : ∀ s : Set Ω, MeasurableSet[m] s → e ⁻¹' s = s)
    (f g : Ω → ℝ) (hf : Integrable f μ) (hg : Integrable g μ)
    (hcomp : ∀ ω, f (e ω) = g ω) :
    μ[f | m] =ᵐ[μ] μ[g | m] := by
  letI : MeasurableSpace Ω := mΩ
  apply Filter.EventuallyEq.symm
  apply ae_eq_condExp_of_forall_setIntegral_eq hm hf
  · intro s hs hfinite
    exact integrable_condExp.integrableOn
  · intro s hs hfinite
    rw [setIntegral_condExp hm hg hs]
    exact setIntegral_transport_of_invariant_equiv e he s (hm s hs) (hinv s hs) f g hcomp
  · exact stronglyMeasurable_condExp.aestronglyMeasurable

/-- Oddness under an actual observable-preserving involutive symmetry forces
zero conditional mean. The proof does not assume the conditional mean. -/
theorem condExp_zero_of_invariant_odd
    (m : MeasurableSpace Ω) (hm : m ≤ mΩ)
    (e : @MeasurableEquiv Ω Ω mΩ mΩ) (he : @MeasurePreserving Ω Ω mΩ mΩ e μ μ)
    (hinv : ∀ s : Set Ω, MeasurableSet[m] s → e ⁻¹' s = s)
    (f : Ω → ℝ) (hf : Integrable f μ)
    (hodd : ∀ ω, f (e ω) = -f ω) :
    μ[f | m] =ᵐ[μ] (fun _ => (0 : ℝ)) := by
  letI : MeasurableSpace Ω := mΩ
  have htransport := condExp_transport_of_invariant_equiv m hm e he hinv f (-f)
    hf hf.neg hodd
  have hneg := condExp_neg (μ := μ) f m
  filter_upwards [htransport, hneg] with ω hω hnω
  change (μ[f | m]) ω = (μ[-f | m]) ω at hω
  change (μ[-f | m]) ω = -(μ[f | m]) ω at hnω
  linarith

/-- Coordinate-swapping probability-space symmetries and a known norm identity
force isotropic conditional second moments. The symmetry premise is at the
measure level, rather than the desired conditional-moment conclusion. -/
theorem conditional_isotropic_second_moment_of_transports
    (d : ℕ) (hd : 0 < d) (m : MeasurableSpace Ω) (hm : m ≤ mΩ)
    (X : Fin d → Ω → ℝ) (Y : Ω → ℝ)
    (hX : ∀ i, Integrable (fun ω => (X i ω) ^ 2) μ)
    (hY : Integrable Y μ) (hYm : StronglyMeasurable[m] Y)
    (hsum : (fun ω => ∑ i : Fin d, (X i ω) ^ 2) =ᵐ[μ] Y)
    (hsym : ∀ i j : Fin d, ∃ e : @MeasurableEquiv Ω Ω mΩ mΩ,
      @MeasurePreserving Ω Ω mΩ mΩ e μ μ ∧
      (∀ s : Set Ω, MeasurableSet[m] s → e ⁻¹' s = s) ∧
      (∀ ω, (X i (e ω)) ^ 2 = (X j ω) ^ 2))
    (i : Fin d) :
    μ[(fun ω => (X i ω) ^ 2) | m] =ᵐ[μ] (fun ω => Y ω / d) := by
  letI : MeasurableSpace Ω := mΩ
  classical
  have hpair (j : Fin d) :
      μ[(fun ω => (X j ω) ^ 2) | m] =ᵐ[μ]
        μ[(fun ω => (X i ω) ^ 2) | m] := by
    obtain ⟨e, he, hinv, hcomp⟩ := hsym j i
    exact condExp_transport_of_invariant_equiv m hm e he hinv _ _ (hX j) (hX i) hcomp
  have hall : ∀ᵐ ω ∂μ, ∀ j : Fin d,
      (μ[(fun ω => (X j ω) ^ 2) | m]) ω =
        (μ[(fun ω => (X i ω) ^ 2) | m]) ω := by
    rw [ae_all_iff]
    exact hpair
  have hcesum := condExp_finsetSum
    (s := Finset.univ) (f := fun j : Fin d => fun ω => (X j ω) ^ 2)
    (fun j _ => hX j) m
  have hsumfun : (∑ j : Fin d, fun ω => (X j ω) ^ 2) =
      (fun ω => ∑ j : Fin d, (X j ω) ^ 2) := by
    funext ω
    simp only [Finset.sum_apply]
  rw [hsumfun] at hcesum
  have hceY : μ[(fun ω => ∑ j : Fin d, (X j ω) ^ 2) | m] =ᵐ[μ] Y := by
    exact (condExp_congr_ae hsum).trans
      (Filter.EventuallyEq.of_eq (condExp_of_stronglyMeasurable hm hYm hY))
  filter_upwards [hall, hcesum, hceY] with ω heq hs hy
  have hsumω : (∑ j : Fin d, (μ[(fun ω => (X j ω) ^ 2) | m]) ω) = Y ω := by
    simpa only [Finset.sum_apply] using hs.symm.trans hy
  have hconst : (∑ j : Fin d, (μ[(fun ω => (X j ω) ^ 2) | m]) ω) =
      (d : ℝ) * (μ[(fun ω => (X i ω) ^ 2) | m]) ω := by
    calc
      _ = ∑ _j : Fin d, (μ[(fun ω => (X i ω) ^ 2) | m]) ω := by
        apply Finset.sum_congr rfl
        intro j hj
        exact heq j
      _ = _ := by simp
  have hd0 : (d : ℝ) ≠ 0 := by positivity
  apply (eq_div_iff hd0).2
  nlinarith

#print axioms comap_event_invariant
#print axioms setIntegral_transport_of_invariant_equiv
#print axioms condExp_transport_of_invariant_equiv
#print axioms condExp_zero_of_invariant_odd
#print axioms conditional_isotropic_second_moment_of_transports

end
end Task006.AdaptiveSphere
