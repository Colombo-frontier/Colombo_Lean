theorem event_bound_of_conditional_indicator
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : MeasurableSpace Ω)
    (hF : F ≤ mΩ) (A : Set Ω) (hA : MeasurableSet[mΩ] A) (p : ℝ)
