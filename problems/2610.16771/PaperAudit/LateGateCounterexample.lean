    simpa only [Real.norm_eq_abs, sq_abs] using hv.sum_inner_products_le (s := Finset.univ) (x := z)
  have hl : (∑ i : Fin n, (inner ℝ (v i.castSucc) z) ^ 2) ≤ ‖z‖ ^ 2 := by
