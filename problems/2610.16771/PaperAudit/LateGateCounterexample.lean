theorem internal_rho_matches_external (cL L mu eps r : ℝ)
    (hcL : 0 < cL) (hcL1 : cL ≤ 1) (hL : 0 < L) (hmu : 0 < mu) (heps : 0 < eps) (hr : 1 ≤ r) :
