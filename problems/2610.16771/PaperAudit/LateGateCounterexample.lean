structure Witness where
  kappa : ℝ
  r : ℝ
  rho : ℝ
  Delta : ℝ
  rhop : ℝ
  omega : ℝ
  delta : ℝ
  q : ℕ
  nt : ℕ

def twoPacketDelta (cT L : ℝ) : ℝ := 5 / (2 * cT * L)

theorem two_packet_time_and_constructor_budget (cT L : ℝ) (hcT : 0 < cT) (hL : 0 < L) :
    0 < twoPacketDelta cT L ∧ Nat.floor (cT * twoPacketDelta cT L * L) = 2 ∧
      2 ≤ cT * twoPacketDelta cT L / energy L 1 := by
  have hD : 0 < twoPacketDelta cT L := by dsimp [twoPacketDelta]; positivity
  have htime : cT * twoPacketDelta cT L * L = (5 / 2 : ℝ) := by
    dsimp [twoPacketDelta]
    field_simp
  have hbudget : cT * twoPacketDelta cT L / energy L 1 = (5 / 2 : ℝ) := by
    dsimp [twoPacketDelta, energy]
    field_simp
  exact ⟨hD, by rw [htime]; norm_num, by rw [hbudget]; norm_num⟩

/-- Exact external parameterization and actual simultaneous physical alignment
    for the strict hierarchy, with nu=16 at external mu=1. -/
def Legal (Cm Cw cg KD cL cq cT cdelta : ℝ) (q0 : ℕ) (threshold : ℝ) (w : Witness) : Prop :=
  1 ≤ w.kappa ∧ 1 ≤ w.r ∧ 0 < w.rho ∧
  w.rho = FangqingThirdGroupScaling.rho w.kappa 1 1 w.r ∧
  regime w.kappa w.rho 1 w.kappa = w.r ∧
  w.q = packetLength cq (regime w.kappa w.rho 1 w.kappa) w.kappa ∧
  8 ≤ w.q ∧ q0 ≤ w.q ∧ threshold < (w.q : ℝ) ∧
  (q0 : ℝ) ≤ cq * min ((regime w.kappa w.rho 1 w.kappa) ^ (2 / 7 : ℝ)) (Real.sqrt w.kappa) ∧
  (w.q : ℝ) ^ 2 ≤ cq ^ 2 * w.kappa ∧
  let D := distance (KD / (2 * Real.sqrt cL)) w.kappa 1 w.kappa
  w.rhop = packetBudget Cw cg 16 D w.q ∧ 0 < w.rhop ∧ w.rhop ≤ w.rho / 8 ∧ w.rhop ≤ w.rho ∧
  w.omega = edgeWidth Cw cg 16 w.rhop w.q ∧ 0 < w.omega ∧
  let scale := cg * w.rhop
  let barlam := 16 / scale
  0 < scale ∧ 0 < barlam ∧ scale * barlam = 16 ∧
  w.omega = Cw * barlam * (w.q : ℝ) ^ 2 ∧
  distanceScale (w.q : ℝ) w.omega = packetD (2 * cL * w.kappa) 2 KD 1 ∧
  w.delta = cdelta * w.omega ∧ 0 < w.delta ∧ w.delta ≤ w.omega ∧
  w.nt = OriginalPacketBulkIndexing.packetIndex Cm w.q ∧
  ((w.nt + 2 : ℕ) : ℝ) ≤ Cm * (w.q : ℝ) ∧
  Nat.ceil (Cm * (w.q : ℝ)) = w.nt + 3 ∧ w.q ≤ w.nt + 2 ∧
  w.Delta = twoPacketDelta cT w.kappa ∧ 0 < w.Delta ∧
  Nat.floor (cT * w.Delta * w.kappa) = 2 ∧
  2 ≤ cT * w.Delta / energy w.kappa 1 ∧
  1 ≤ w.r / (4 * Real.sqrt cL) ∧
  FangqingThirdGroupScaling.rho (2 * cL * w.kappa) 2 1 (w.r / (4 * Real.sqrt cL)) = w.rho

/-- All constants are fixed by the strict hierarchy before the requested
    length threshold; no replacement of its original cq floor is made. -/
theorem legal_hierarchy_parameters_unbounded
    (Cm Cw cg KD cL cq cT cdelta : ℝ)
    (hCm : 4 ≤ Cm) (hCw : 0 < Cw) (hcg : 0 < cg) (hKD : 0 < KD)
    (hcL : 0 < cL) (hcL256 : cL ≤ 1 / 256) (hcq : 0 < cq) (hcq1 : cq ≤ 1)
    (hcT : 0 < cT) (hcd : 0 < cdelta) (hcd1 : cdelta ≤ 1)
    (hAlignment : AlignmentAvailable cq cL Cw cg KD) :
    ∀ (q0 : ℕ), 1 ≤ q0 → ∀ threshold : ℝ,
      ∃ w : Witness, Legal Cm Cw cg KD cL cq cT cdelta q0 threshold w := by
  intro q0 hq0 threshold
  let Q := max (max q0 8) (Nat.ceil threshold + 1)
  obtain ⟨kap, r, hkap, hr, hQ⟩ :=
    original_packet_length_can_exceed_every_fixed_threshold cq hcq hcq1 Q
  let rho := FangqingThirdGroupScaling.rho kap 1 1 r
  let q := packetLength cq r kap
  let D := distance (KD / (2 * Real.sqrt cL)) kap 1 kap
  let rhop := packetBudget Cw cg 16 D q
  let omega := edgeWidth Cw cg 16 rhop q
  let delta := cdelta * omega
  let nt := OriginalPacketBulkIndexing.packetIndex Cm q
  let Delta := twoPacketDelta cT kap
  have hkap0 : 0 < kap := zero_lt_one.trans_le hkap
  have hr0 : 0 < r := zero_lt_one.trans_le hr
  have hrho : 0 < rho := by dsimp [rho, FangqingThirdGroupScaling.rho]; positivity
  have hReg : regime kap rho 1 kap = r := actual_external_regime_is_the_same_public_r kap r hkap0
  have hQ0 : q0 ≤ Q := (Nat.le_max_left q0 8).trans (Nat.le_max_left _ _)
  have hQ8 : 8 ≤ Q := (Nat.le_max_right q0 8).trans (Nat.le_max_left _ _)
  have hq0w : q0 ≤ q := hQ0.trans hQ
  have hq8 : 8 ≤ q := hQ8.trans hQ
  have hqpos : 0 < q := by omega
  have hqr : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hqpos
  have hqnonneg : 0 ≤ cq * min (r ^ (2 / 7 : ℝ)) (Real.sqrt kap) := by positivity
  have hqbound : (q : ℝ) ≤ cq * min (r ^ (2 / 7 : ℝ)) (Real.sqrt kap) := Nat.floor_le hqnonneg
  have hnd : (q0 : ℝ) ≤ cq * min ((regime kap rho 1 kap) ^ (2 / 7 : ℝ)) (Real.sqrt kap) := by
    rw [hReg]
    exact (show (q0 : ℝ) ≤ (q : ℝ) by exact_mod_cast hq0w).trans hqbound
  have hqSqrt : (q : ℝ) ≤ cq * Real.sqrt kap :=
    hqbound.trans (mul_le_mul_of_nonneg_left (min_le_right _ _) hcq.le)
  have hq2 : (q : ℝ) ^ 2 ≤ cq ^ 2 * kap := by
    have hb := (sq_le_sq₀ (Nat.cast_nonneg q) (mul_nonneg hcq.le (Real.sqrt_nonneg kap))).mpr hqSqrt
    simpa only [mul_pow, Real.sq_sqrt hkap0.le] using hb
  have hThreshold : threshold < (q : ℝ) := by
    have ht := Nat.le_ceil threshold
    have hc : Nat.ceil threshold + 1 ≤ Q := Nat.le_max_right _ _
    have hcast : (Nat.ceil threshold : ℝ) + 1 ≤ (q : ℝ) := by exact_mod_cast hc.trans hQ
    linarith only [ht, hcast]
  have hAligned := hAlignment kap rho 1 1 q0 hkap0 hrho (by norm_num) (by norm_num) hq0 (by simpa only [div_one] using hnd)
  dsimp only at hAligned
  simp only [div_one] at hAligned
  rw [hReg] at hAligned
  have hNu : curvature 16 kap kap = 16 := by unfold curvature; field_simp
  rw [hNu] at hAligned
  obtain ⟨hqN, hqHalf, hqArg, hscale, hbarlam, hw, hR, hRB, hMass, hOmega, hD⟩ := hAligned
  change 0 < cg * rhop at hscale
  change 0 < 16 / (cg * rhop) at hbarlam
  change 0 < omega at hw
  change 0 < rhop at hR
  change rhop ≤ rho / 8 at hRB
  have hMass' : (cg * rhop) * (16 / (cg * rhop)) = 16 := by
    convert hMass using 1 <;> norm_num
  have hOmega' : omega = Cw * (16 / (cg * rhop)) * (q : ℝ) ^ 2 := hOmega
  have hD' : distanceScale (q : ℝ) omega = packetD (2 * cL * kap) 2 KD 1 := by
    simpa only [mul_one] using hD
  have hdelta : 0 < delta := mul_pos hcd hw
  have hdeltaW : delta ≤ omega := mul_le_of_le_one_left hw.le hcd1
  have hceil := OriginalPacketBulkIndexing.original_ceil_path_conditions Cm hCm q (by omega)
  have hTime := two_packet_time_and_constructor_budget cT kap hcT hkap0
  have hInternal := doubled_internal_rho_matches_external cL kap 1 1 r hcL hcL256 hkap0
    (by norm_num) (by norm_num) hr
  refine ⟨⟨kap, r, rho, Delta, rhop, omega, delta, q, nt⟩, ?_⟩
  exact ⟨hkap, hr, hrho, rfl, hReg, by rw [hReg], hq8, hq0w, hThreshold, hnd, hq2,
    rfl, hR, hRB, by linarith only [hRB, hrho], rfl, hw, hscale, hbarlam, hMass', hOmega', hD',
    rfl, hdelta, hdeltaW, rfl, hceil.2.2.1, hceil.2.1, hceil.2.2.2,
    rfl, hTime.1, hTime.2.1, hTime.2.2, hInternal.1, by simpa only [mul_one] using hInternal.2⟩

/-- The actual scalar premises of the strict hierarchy constructor,
    specialized to external mu=eps=1 and two packets. -/
def ConstructorInputs (Cm Cw cg KD cL cq cT : ℝ) (w : Witness) : Prop :=
  0 < w.kappa ∧ (0 : ℝ) < 1 ∧ (0 : ℝ) < 1 ∧ 1 ≤ w.r ∧
  0 < w.rhop ∧ w.rhop ≤ FangqingThirdGroupScaling.rho w.kappa 1 1 w.r ∧
  (1 : ℝ) ≤ (w.q : ℝ) ∧ (w.q : ℝ) ^ 2 ≤ cq ^ 2 * (w.kappa / 1) ∧
  0 < w.delta ∧ w.delta ≤ w.omega ∧ ((w.nt + 2 : ℕ) : ℝ) ≤ Cm * (w.q : ℝ) ∧
  0 ≤ w.Delta ∧ 2 ≤ cT * w.Delta / energy w.kappa 1 ∧
  w.omega = Cw * ((8 * 2) / (cg * w.rhop)) * (w.q : ℝ) ^ 2 ∧
  distanceScale (w.q : ℝ) w.omega = packetD (2 * cL * w.kappa) 2 KD 1

theorem legal_constructor_inputs
