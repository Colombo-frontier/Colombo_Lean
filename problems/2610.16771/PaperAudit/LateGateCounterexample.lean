    (coeff : Fin (n + 3) → ℝ) (frame : Fin (n + 3) → E) : Query E :=
  coordinateIsometry ((1 : Fin 3), (0 : Fin 2)) ((omega / 2) • frame current) +
    coordinateIsometry ((2 : Fin 3), (0 : Fin 2))
      (a • (-(tau • prefixPoint n cutoff alpha handle coeff frame) + offset • handle))

