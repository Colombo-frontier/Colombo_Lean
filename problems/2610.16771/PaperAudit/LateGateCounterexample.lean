theorem actual_regime_of_physical_rho (L mu eps r : ℝ)
    (hL : 0 < L) (hmu : 0 < mu) (heps : 0 < eps) :
    regime L (FangqingThirdGroupScaling.rho L mu eps r) eps (L / mu) = r := by
  have hk : 0 < L / mu := div_pos hL hmu
  have hs : 0 < Real.sqrt (L / mu) := Real.sqrt_pos.mpr hk
  unfold regime FangqingThirdGroupScaling.rho
  rw [rpow_three_halves (L / mu) hk]
  field_simp [hL.ne', hmu.ne', heps.ne', hk.ne', hs.ne']

theorem internal_actual_regime (cL L mu eps r : ℝ)
    (hcL : 0 < cL) (hcL1 : cL ≤ 1) (hL : 0 < L) (hmu : 0 < mu) (heps : 0 < eps) (hr : 1 ≤ r) :
    regime (cL * L) (FangqingThirdGroupScaling.rho L mu eps r) eps ((cL * L) / mu) = r / Real.sqrt cL := by
  have h := internal_rho_matches_external cL L mu eps r hcL hcL1 hL hmu heps hr
  rw [← h.2]
  exact actual_regime_of_physical_rho (cL * L) mu eps (r / Real.sqrt cL) (mul_pos hcL hL) hmu heps

theorem unbounded_shared_external_internal_floor
    (cL cqi : ℝ) (hcL : 0 < cL) (hcL1 : cL ≤ 1) (hcqi : 0 < cqi) (hcqi1 : cqi ≤ 1) (Q : ℕ) :
    let cqe := cqi * Real.sqrt cL
    ∃ kappa r : ℝ, 1 ≤ kappa ∧ 1 ≤ r ∧
      Q ≤ packetLength cqe r kappa ∧
      packetLength cqe r kappa = packetLength cqi (r / Real.sqrt cL) (cL * kappa) ∧
      (Q : ℝ) ≤ cqi * min ((r / Real.sqrt cL) ^ (2 / 7 : ℝ)) (Real.sqrt (cL * kappa)) := by
  intro cqe
  have hsL : 0 < Real.sqrt cL := Real.sqrt_pos.mpr hcL
  have hsL1 : Real.sqrt cL ≤ 1 := by simpa using Real.sqrt_le_sqrt hcL1
  have hcqe : 0 < cqe := mul_pos hcqi hsL
  let S := ((Q : ℝ) + 1) / cqe + 1
  have hS : 1 ≤ S := by dsimp only [S]; have := div_nonneg (by positivity : 0 ≤ (Q : ℝ) + 1) hcqe.le; linarith
  have hS0 : 0 < S := zero_lt_one.trans_le hS
  have hS2 : S ≤ S ^ 2 := by nlinarith only [hS, sq_nonneg (S - 1)]
  have hpow : (S ^ 7) ^ (2 / 7 : ℝ) = S ^ 2 := by
    calc
      _ = (S ^ (7 : ℝ)) ^ (2 / 7 : ℝ) := by norm_num
      _ = S ^ ((7 : ℝ) * (2 / 7)) := (Real.rpow_mul hS0.le _ _).symm
      _ = _ := by norm_num
  have hminE : min ((S ^ 7) ^ (2 / 7 : ℝ)) (Real.sqrt (S ^ 2)) = S := by
    rw [hpow, Real.sqrt_sq hS0.le, min_eq_right hS2]
  have hr : 1 ≤ S ^ 7 := one_le_pow₀ hS
  have hrI : S ^ 7 ≤ S ^ 7 / Real.sqrt cL := by
    apply (le_div_iff₀ hsL).mpr
    exact mul_le_of_le_one_right (by positivity) hsL1
  have hpowI : S ^ 2 ≤ (S ^ 7 / Real.sqrt cL) ^ (2 / 7 : ℝ) := by
    rw [← hpow]
    exact Real.rpow_le_rpow (by positivity) hrI (by norm_num)
  have hsqrtI : Real.sqrt (cL * S ^ 2) = Real.sqrt cL * S := by
    rw [Real.sqrt_mul hcL.le, Real.sqrt_sq hS0.le]
  have hminI : min ((S ^ 7 / Real.sqrt cL) ^ (2 / 7 : ℝ)) (Real.sqrt (cL * S ^ 2)) = Real.sqrt cL * S := by
    rw [hsqrtI]
    apply min_eq_right
    exact (mul_le_of_le_one_left hS0.le hsL1).trans (hS2.trans hpowI)
  have harg : cqi * (Real.sqrt cL * S) = cqe * S := by dsimp only [cqe]; ring
  have hvalue : cqe * S = (Q : ℝ) + 1 + cqe := by dsimp only [S]; field_simp
  have hQ : Q ≤ packetLength cqe (S ^ 7) (S ^ 2) := by
    unfold packetLength
    rw [hminE]
    apply Nat.le_floor
    rw [hvalue]
    linarith only [hcqe]
  refine ⟨S ^ 2, S ^ 7, one_le_pow₀ hS, hr, hQ, ?_, ?_⟩
  · unfold packetLength
    rw [hminE, hminI, harg]
  · rw [hminI, harg, hvalue]
    linarith only [hcqe]

def timeConstant (Cgap : ℝ) : ℝ := 1 / (1 + 4 * Cgap)
def twoPacketDelta (Cgap L : ℝ) : ℝ := (5 / 2 : ℝ) / (timeConstant Cgap * L)

theorem two_packet_original_time_and_gap (Cgap L : ℝ) (hgap : 0 ≤ Cgap) (hL : 0 < L) :
    0 < timeConstant Cgap ∧ timeConstant Cgap ≤ 1 ∧ 0 < twoPacketDelta Cgap L ∧
      Nat.floor (timeConstant Cgap * twoPacketDelta Cgap L * L) = 2 ∧
      2 * Cgap * energy L 1 ≤ twoPacketDelta Cgap L / 2 := by
  have hct : 0 < timeConstant Cgap := by dsimp [timeConstant]; positivity
  have hct1 : timeConstant Cgap ≤ 1 := by
    dsimp [timeConstant]
    apply (div_le_iff₀ (by positivity : 0 < 1 + 4 * Cgap)).mpr
    linarith only [hgap]
  have hD : 0 < twoPacketDelta Cgap L := by dsimp [twoPacketDelta]; positivity
  have ht : timeConstant Cgap * twoPacketDelta Cgap L * L = (5 / 2 : ℝ) := by
    dsimp [twoPacketDelta]
    field_simp [hct.ne', hL.ne']
  refine ⟨hct, hct1, hD, ?_, ?_⟩
  · rw [ht]; norm_num
  · apply (mul_le_mul_iff_of_pos_right hL).mp
    dsimp [twoPacketDelta, timeConstant, energy]
    field_simp [hL.ne', show 1 + 4 * Cgap ≠ 0 by positivity]
    nlinarith only [hgap]

structure Witness where
  kappa : ℝ
  r : ℝ
  rho : ℝ
  Delta : ℝ
  rhop : ℝ
  omega : ℝ
  delta : ℝ
  q : ℕ
  nt : ℕ

def Legal (Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap : ℝ) (q0 : ℕ) (threshold : ℝ) (w : Witness) : Prop :=
  1 ≤ w.kappa ∧ 1 ≤ w.r ∧ 0 < w.rho ∧
  w.rho = FangqingThirdGroupScaling.rho w.kappa 1 1 w.r ∧
  regime w.kappa w.rho 1 w.kappa = w.r ∧
  w.q = packetLength cqe (regime w.kappa w.rho 1 w.kappa) w.kappa ∧
  8 ≤ w.q ∧ q0 ≤ w.q ∧ threshold < (w.q : ℝ) ∧
  (q0 : ℝ) ≤ cqe * min ((regime w.kappa w.rho 1 w.kappa) ^ (2 / 7 : ℝ)) (Real.sqrt w.kappa) ∧
  let Li := cL * w.kappa
  let ri := w.r / Real.sqrt cL
  let D := packetD Li 1 KD 1
  0 < Li ∧ 1 ≤ ri ∧ regime Li w.rho 1 Li = ri ∧
  w.q = packetLength cqi (regime Li w.rho 1 Li) Li ∧
  (w.q : ℝ) ^ 2 ≤ cqcap ^ 2 * w.kappa ∧
  w.rhop = packetBudget Cw cg 8 D w.q ∧ 0 < w.rhop ∧ w.rhop ≤ w.rho / 8 ∧
  w.omega = edgeWidth Cw cg 8 w.rhop w.q ∧ 0 < w.omega ∧
  w.omega = Cw * (8 / (cg * w.rhop)) * (w.q : ℝ) ^ 2 ∧
  distanceScale (w.q : ℝ) w.omega = D ∧
  w.delta = cdelta * w.omega ∧ 0 < w.delta ∧ w.delta ≤ w.omega ∧
  w.nt = OriginalPacketBulkIndexing.packetIndex Cm w.q ∧
  ((w.nt + 2 : ℕ) : ℝ) ≤ Cm * (w.q : ℝ) ∧
  Nat.ceil (Cm * (w.q : ℝ)) = w.nt + 3 ∧
  w.Delta = twoPacketDelta Cgap w.kappa ∧ 0 < w.Delta ∧
  Nat.floor (cT * w.Delta * w.kappa) = 2 ∧
  2 * Cgap * energy w.kappa 1 ≤ w.Delta / 2

theorem legal_original_two_packet_parameters_unbounded
    (Cm Cw cg KD cL cqcap cdelta Cgap : ℝ)
    (hCm : 4 ≤ Cm) (hCw : 0 < Cw) (hcg : 0 < cg) (hKD : 0 < KD)
    (hcL : 0 < cL) (hcL1 : cL ≤ 1) (hcap : 0 < cqcap)
    (hcd : 0 < cdelta) (hcd1 : cdelta ≤ 1) (hgap : 0 ≤ Cgap) :
    ∃ cqi cqe cT : ℝ, 0 < cqi ∧ cqi ≤ 1 ∧ cqi ≤ cqcap ∧
      cqe = cqi * Real.sqrt cL ∧ 0 < cqe ∧ cqe ≤ 1 ∧
      cT = timeConstant Cgap ∧ 0 < cT ∧ cT ≤ 1 ∧
      ∀ (q0 : ℕ), 1 ≤ q0 → ∀ threshold : ℝ,
        ∃ w : Witness, Legal Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap q0 threshold w := by
  obtain ⟨cqi, hcqi, hcqi1, hcqcap, hAlignment⟩ :=
    reserved_parameter_alignment 8 Cw cg KD cqcap (by norm_num) hCw hcg hKD hcap
  let cqe := cqi * Real.sqrt cL
  let cT := timeConstant Cgap
  have hsL : 0 < Real.sqrt cL := Real.sqrt_pos.mpr hcL
  have hsL1 : Real.sqrt cL ≤ 1 := by simpa using Real.sqrt_le_sqrt hcL1
  have hcqe : 0 < cqe := mul_pos hcqi hsL
  have hcqe1 : cqe ≤ 1 := (mul_le_of_le_one_right hcqi.le hsL1).trans hcqi1
  have hct := two_packet_original_time_and_gap Cgap 1 hgap (by norm_num)
  refine ⟨cqi, cqe, cT, hcqi, hcqi1, hcqcap, rfl, hcqe, hcqe1, rfl, hct.1, hct.2.1, ?_⟩
  intro q0 hq0min threshold
  let Q := max (max q0 8) (Nat.ceil threshold + 1)
  obtain ⟨kap, r, hkap, hr, hQ, hSame, hLarge⟩ :=
    unbounded_shared_external_internal_floor cL cqi hcL hcL1 hcqi hcqi1 Q
  let L := kap
  let Li := cL * L
  let ri := r / Real.sqrt cL
  let rho := FangqingThirdGroupScaling.rho L 1 1 r
  let q := packetLength cqe r kap
  let D := packetD Li 1 KD 1
  let rhop := packetBudget Cw cg 8 D q
  let omega := edgeWidth Cw cg 8 rhop q
  let delta := cdelta * omega
  let nt := OriginalPacketBulkIndexing.packetIndex Cm q
  let Delta := twoPacketDelta Cgap L
  have hL : 0 < L := zero_lt_one.trans_le hkap
  have hLi : 0 < Li := mul_pos hcL hL
  have hr0 : 0 < r := zero_lt_one.trans_le hr
  have hrho : 0 < rho := by dsimp [rho, FangqingThirdGroupScaling.rho]; positivity
  have hRegE : regime L rho 1 kap = r := by
    simpa only [div_one] using actual_regime_of_physical_rho L 1 1 r hL (by norm_num) (by norm_num)
  have hInternal := internal_rho_matches_external cL L 1 1 r hcL hcL1 hL (by norm_num) (by norm_num) hr
  have hri : 1 ≤ ri := hInternal.1
  have hRegI : regime Li rho 1 Li = ri := by
    simpa only [div_one] using internal_actual_regime cL L 1 1 r hcL hcL1 hL (by norm_num) (by norm_num) hr
  have hQ0 : q0 ≤ Q := (Nat.le_max_left q0 8).trans (Nat.le_max_left _ _)
  have hQ8 : 8 ≤ Q := (Nat.le_max_right q0 8).trans (Nat.le_max_left _ _)
  have hq0 : q0 ≤ q := hQ0.trans hQ
  have hq8 : 8 ≤ q := hQ8.trans hQ
  have hqpos : 0 < q := by omega
  have hqr : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hqpos
  have hQceil : Nat.ceil threshold + 1 ≤ Q := Nat.le_max_right _ _
  have hThreshold : threshold < (q : ℝ) := by
    have ht := Nat.le_ceil threshold
    have hb : (Nat.ceil threshold : ℝ) + 1 ≤ (q : ℝ) := by exact_mod_cast hQceil.trans hQ
    linarith only [ht, hb]
  have hQ0r : (q0 : ℝ) ≤ (Q : ℝ) := by exact_mod_cast hQ0
  have hnd : (q0 : ℝ) ≤ cqi * min ((regime Li rho 1 Li) ^ (2 / 7 : ℝ)) (Real.sqrt Li) := by
    rw [hRegI]
    exact hQ0r.trans hLarge
  have hAligned := hAlignment Li rho 1 Li q0 hLi hrho (by norm_num) hLi hq0min hnd
  dsimp only at hAligned
  rw [hRegI, ← hSame] at hAligned
  have hNu : curvature 8 Li Li = 8 := by unfold curvature; field_simp [hLi.ne']
  have hDist : distance KD Li 1 Li = D := by simp [D, distance, packetD]
  rw [hNu, hDist] at hAligned
  obtain ⟨_, _, _, hqBoundI, _, hDpos, hrhop, hw, hDomega, hrhopBound, _⟩ := hAligned
  change (q : ℝ) ^ 2 ≤ cqcap ^ 2 * Li at hqBoundI
  change 0 < rhop at hrhop
  change 0 < omega at hw
  change D = (q : ℝ) ^ (3 / 2 : ℝ) * omega at hDomega
  change rhop ≤ rho / 8 at hrhopBound
  have hLiL : Li ≤ kap := mul_le_of_le_one_left hL.le hcL1
  have hqBound : (q : ℝ) ^ 2 ≤ cqcap ^ 2 * kap :=
    hqBoundI.trans (mul_le_mul_of_nonneg_left hLiL (sq_nonneg _))
  have hndE : (q0 : ℝ) ≤ cqe * min ((regime L rho 1 kap) ^ (2 / 7 : ℝ)) (Real.sqrt kap) := by
    rw [hRegE]
    have hqfloor := Nat.floor_le (show 0 ≤ cqe * min (r ^ (2 / 7 : ℝ)) (Real.sqrt kap) by positivity)
    have hq0r : (q0 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq0
    exact hq0r.trans hqfloor
  have hOmega : omega = Cw * (8 / (cg * rhop)) * (q : ℝ) ^ 2 := by
    dsimp only [omega, edgeWidth]
    field_simp
    <;> ring
  have hDistance : distanceScale (q : ℝ) omega = D := by
    rw [rpow_three_halves (q : ℝ) hqr] at hDomega
    exact hDomega.symm
  have hdelta : 0 < delta := mul_pos hcd hw
  have hdeltaW : delta ≤ omega := mul_le_of_le_one_left hw.le hcd1
  have hceil := OriginalPacketBulkIndexing.original_ceil_path_conditions Cm hCm q (by omega)
  have hTime := two_packet_original_time_and_gap Cgap L hgap hL
  refine ⟨⟨kap, r, rho, Delta, rhop, omega, delta, q, nt⟩, ?_⟩
  exact ⟨hkap, hr, hrho, rfl, hRegE, by rw [hRegE], hq8, hq0, hThreshold, hndE,
    hLi, hri, hRegI, by rw [hRegI, ← hSame], hqBound, rfl, hrhop, hrhopBound,
    rfl, hw, hOmega, hDistance, rfl, hdelta, hdeltaW, rfl, hceil.2.2.1, hceil.2.1,
    rfl, hTime.2.2.1, hTime.2.2.2.1, hTime.2.2.2.2⟩

/-- These are precisely the physical scalar premises consumed by
    actual_external_worlds_have_public_canonical_centers at L=kappa, mu=eps=1. -/
def WorldArguments (Cm Cw cg KD cL cqcap : ℝ) (w : Witness) : Prop :=
  0 < w.kappa ∧ (0 : ℝ) < 1 ∧ (0 : ℝ) < 1 ∧ 1 ≤ w.r ∧
  0 < w.rhop ∧ w.rhop ≤ FangqingThirdGroupScaling.rho w.kappa 1 1 w.r ∧
  (1 : ℝ) ≤ (w.q : ℝ) ∧ (w.q : ℝ) ^ 2 ≤ cqcap ^ 2 * (w.kappa / 1) ∧
  0 < w.delta ∧ w.delta ≤ w.omega ∧ ((w.nt + 2 : ℕ) : ℝ) ≤ Cm * (w.q : ℝ) ∧
  w.omega = Cw * ((8 * 1) / (cg * w.rhop)) * (w.q : ℝ) ^ 2 ∧
  distanceScale (w.q : ℝ) w.omega = packetD (cL * w.kappa) 1 KD 1

theorem legal_world_parameter_premises
    (Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap : ℝ) (q0 : ℕ) (threshold : ℝ) (w : Witness)
    (h : Legal Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap q0 threshold w) :
    WorldArguments Cm Cw cg KD cL cqcap w := by
  rcases h with ⟨hk, hr, hrho, hrhoEq, hRegE, hqEq, hq8, hq0, hthreshold, hnd,
    hLi, hri, hRegI, hqInternal, hqBound, hrhopEq, hrhop, hrhopBound,
    homegaEq, homegaPos, homega, hDistance, hdeltaEq, hdelta, hdeltaW,
    hntEq, hntBound, hntLength, hDeltaEq, hDelta, hT, hgap⟩
  have hrhopExt : w.rhop ≤ FangqingThirdGroupScaling.rho w.kappa 1 1 w.r := by
    rw [← hrhoEq]
    linarith only [hrhopBound, hrho]
  have hq : (1 : ℝ) ≤ (w.q : ℝ) := by exact_mod_cast (show 1 ≤ w.q by omega)
  exact ⟨zero_lt_one.trans_le hk, by norm_num, by norm_num, hr, hrhop, hrhopExt, hq,
    by simpa only [div_one] using hqBound, hdelta, hdeltaW, hntBound,
    by simpa only [mul_one] using homega, hDistance⟩

theorem finite_original_dimension_reserve (m : ℕ) (bound : ℝ) :
    ∃ d : ℕ, m ≤ d ∧ bound ≤ ((d - m : ℕ) : ℝ) := by
  obtain ⟨k, hk⟩ := exists_nat_ge bound
  exact ⟨m + k, Nat.le_add_right m k, by simpa only [Nat.add_sub_cancel_left] using hk⟩

theorem legal_world_parameters_and_dimensions
    (Cm Cw cg KD cL cqcap cdelta Cgap : ℝ)
    (hCm : 4 ≤ Cm) (hCw : 0 < Cw) (hcg : 0 < cg) (hKD : 0 < KD)
    (hcL : 0 < cL) (hcL1 : cL ≤ 1) (hcap : 0 < cqcap)
    (hcd : 0 < cdelta) (hcd1 : cdelta ≤ 1) (hgap : 0 ≤ Cgap) :
    ∃ cqi cqe cT : ℝ, 0 < cqi ∧ cqi ≤ 1 ∧ cqi ≤ cqcap ∧
      cqe = cqi * Real.sqrt cL ∧ 0 < cqe ∧ cqe ≤ 1 ∧
      cT = timeConstant Cgap ∧ 0 < cT ∧ cT ≤ 1 ∧
      ∀ (q0 : ℕ), 1 ≤ q0 → ∀ threshold : ℝ,
        ∃ w : Witness, Legal Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap q0 threshold w ∧
          WorldArguments Cm Cw cg KD cL cqcap w ∧
          ∀ bound : ℝ, ∃ d : ℕ, w.nt + 3 ≤ d ∧ bound ≤ ((d - (w.nt + 3) : ℕ) : ℝ) := by
  obtain ⟨cqi, cqe, cT, hi, hi1, hcapq, heq, he, he1, ht, hct, hct1, hUnbounded⟩ :=
    legal_original_two_packet_parameters_unbounded Cm Cw cg KD cL cqcap cdelta Cgap
      hCm hCw hcg hKD hcL hcL1 hcap hcd hcd1 hgap
  refine ⟨cqi, cqe, cT, hi, hi1, hcapq, heq, he, he1, ht, hct, hct1, ?_⟩
  intro q0 hq0 threshold
  obtain ⟨w, hw⟩ := hUnbounded q0 hq0 threshold
  exact ⟨w, hw, legal_world_parameter_premises Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap q0 threshold w hw,
    fun bound => finite_original_dimension_reserve (w.nt + 3) bound⟩

end
end FangqingLegalLateGateParameters
end

