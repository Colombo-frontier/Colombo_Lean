      StrongConvexOn (Set.univ : Set F) nu Q → ConvexOn ℝ (Set.univ : Set F) g →
      (∀ z, ‖iteratedFDeriv ℝ 2 Q z‖ ≤ LQ) →
      (∀ x y, fderiv ℝ (fderiv ℝ Q) x = fderiv ℝ (fderiv ℝ Q) y) →
