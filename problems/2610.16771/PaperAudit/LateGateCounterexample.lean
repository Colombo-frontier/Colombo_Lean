/-- All global construction constants are selected before the length threshold,
    physical parameters, dimension, and orthonormal frame.  The actual family
    is obtained by applying the proved original world factory, not a validity
    assumption on a hypothetical family. -/
theorem actual_legal_late_gate_worlds
    (P : FlatCubic.Profile) (phi : ℝ → ℝ) (Bp left right Cm Cw b0 cdelta : ℝ)
    (hCm : 4 ≤ Cm) (hCw : 4 * (Cm + 2) ≤ Cw) (hb0 : 0 < b0)
    (hp : ContDiff ℝ 3 phi) (hl : ∀ t, t < -Bp → phi t = left) (hr : ∀ t, Bp < t → phi t = right)
    (hcore : ∀ t, |t| < 1 → phi t = t) (hcd : 0 < cdelta) (hcd1 : cdelta ≤ 1) :
    ∃ Ce : ℝ≥0, ∃ K Kc Ks KD csigma Cglobal Cdelta Ctheta Cgap : ℝ,
      0 ≤ K ∧ 0 ≤ Kc ∧ 0 ≤ Ks ∧ 1 ≤ KD ∧ 2 + 1 / b0 ≤ KD ∧ 0 < csigma ∧ 0 ≤ Cglobal ∧
      0 ≤ Cdelta ∧ 0 ≤ Ctheta ∧ 0 ≤ Cgap ∧ (∀ t : ℝ, |deriv theta t| ≤ Ctheta) ∧
      ∃ cL cqcap cg cqi cqe cT : ℝ,
        0 < cL ∧ cL ≤ 1 ∧ 0 < cqcap ∧ cqcap ≤ 1 ∧ 0 < cg ∧ cg ≤ 1 ∧
        0 < cqi ∧ cqi ≤ 1 ∧ cqi ≤ cqcap ∧
        cqe = cqi * Real.sqrt cL ∧ 0 < cqe ∧ cqe ≤ 1 ∧
        cT = timeConstant Cgap ∧ 0 < cT ∧ cT ≤ 1 ∧
        ∀ (q0 : ℕ), 1 ≤ q0 → ∀ threshold : ℝ,
          ∃ w : Witness,
            Legal Cm Cw cg KD cL cqcap cqi cqe cT cdelta Cgap q0 threshold w ∧
            (∀ bound : ℝ, ∃ d : ℕ, w.nt + 3 ≤ d ∧ bound ≤ ((d - (w.nt + 3) : ℕ) : ℝ)) ∧
            ∀ (A B W : Type u)
