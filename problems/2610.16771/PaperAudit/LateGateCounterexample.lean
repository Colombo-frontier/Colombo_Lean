    3 ≤ (lastPositiveIndex z).val ∧ 0 < z (lastPositiveIndex z) ∧
      (∀ i, (lastPositiveIndex z).val < i.val → z i = 0) ∧
      (∀ i, i.val ≤ (lastPositiveIndex z).val → 0 < z i) := by
