    have hh1 := norm_add_le (iteratedFDeriv ℝ 2 Q z) (iteratedFDeriv ℝ 2 (fun z => f z * g z) z)
    exact hh.trans (add_le_add (hh1.trans (add_le_add (hQ2 z) hp2))
      (mul_le_mul_of_nonneg_left (hcol F R hR z).2.1 hgain))
