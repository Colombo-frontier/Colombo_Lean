    (Z : Fin (N + 1) → Fin J → Ω → E) (disclosed : Fin (N + 1) → Ω → ℕ)
    (hV : ∀ i, Measurable (fun ω => V ω i))
    (hZ : ∀ n j, Measurable (Z n j)) (hk : ∀ n, Measurable (disclosed n))
