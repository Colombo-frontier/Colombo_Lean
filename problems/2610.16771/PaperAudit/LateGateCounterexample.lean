variable {Ω : Type*} [MeasurableSpace Ω]

theorem bounded_nat_partition_bound (μ : Measure Ω) [IsProbabilityMeasure μ]
    (K : Ω → ℕ) (hK : Measurable K) (m : ℕ) (hKm : ∀ ω, K ω ≤ m)
    (A : Set Ω) (p : ℝ)
    (hbranch : ∀ k : Fin (m + 1),
      μ.real (A ∩ {ω | K ω = k.val}) ≤ p * μ.real {ω | K ω = k.val}) :
