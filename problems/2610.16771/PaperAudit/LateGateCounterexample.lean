  obtain ⟨hSigma, hPure, hSchur, hSecond, hThird⟩ := hReserve L mu eps r hmu hLmu heps hr
  have hRaw : Kd * (Camp * (8 * mu) * D ^ 2) = rawBudget Cdelta 8 L mu KD eps := by
