      group3 N L mu KD eps a + group4 N L mu KD eps) ≤
      4 * K * N / KD * rho L mu eps r := by
    have hh := mul_le_mul_of_nonneg_left (add_le_add (add_le_add (add_le_add hg1 hg2) hg3) hg4) hK
    convert! hh using 1 <;> ring
