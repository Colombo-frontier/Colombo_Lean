universe u

theorem universal_inactive_shell_class :
    ∃ K : ℝ, 0 ≤ K ∧ ∃ Kc : ℝ, 0 ≤ Kc ∧
    ∀ (F : Type u) [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F],
      ∀ (Q g : F → ℝ) (R nu LQ : ℝ) (M rho : ℝ≥0),
