theorem actual_raw_minimizer_uses_public_coefficients
    (P : FlatCubic.Profile) (C : A ≃ₗᵢ[ℝ] B) (h : A) (hh : ‖h‖ = 1)
    (n : ℕ) (tail : Fin (n + 2) → W) (ht : Orthonormal ℝ tail)
