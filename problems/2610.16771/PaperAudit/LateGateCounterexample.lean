    dsimp [cL]
    apply (div_le_iff₀ (by positivity : 0 < 2 * (Cglobal + 1))).mpr
    linarith only [hG]
  have hden : 0 < 8 * Cp + 1 := by positivity
  have hcq : 0 < cq := Real.sqrt_pos.mpr (div_pos hcL hden)
  have hcq2 : cq ^ 2 = cL / (8 * Cp + 1) := Real.sq_sqrt (by positivity)
