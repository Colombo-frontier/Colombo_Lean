  rw [hsm, hs, sub_zero]

theorem packet_second_jet_bound (Q edge : X → ℝ) (scale LQ Le : ℝ) (seed : X →L[ℝ] ℝ)
    (hscale : 0 ≤ scale) (hQ : ContDiff ℝ 2 Q) (he : ContDiff ℝ 2 edge)
