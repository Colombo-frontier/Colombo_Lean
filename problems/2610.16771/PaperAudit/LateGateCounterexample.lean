    have hcolpos := collar_hessian_nonneg psi hpsi psi_monotone (fun t => (psi_range t).1) R hR z v
    by_cases hz : ‖z‖ < (3 / 2 : ℝ) * R
    · have heq : (fun z => f z * g z) =ᶠ[𝓝 z] g := by
