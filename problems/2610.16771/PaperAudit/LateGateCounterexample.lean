  have h2 := hessian_lower_of_strongConvex edge 0 he (strongConvexOn_zero.mpr hec) x v
  simp only [zero_mul] at h2
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
