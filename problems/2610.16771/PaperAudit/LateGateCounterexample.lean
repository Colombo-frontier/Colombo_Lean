    ∃ u : Group E, u • x₀ = x := by
  let f := (ℝ ∙ (x₀ - x))ᗮ.reflection
  refine ⟨Unitary.linearIsometryEquiv.symm f, ?_⟩
  exact Submodule.reflection_sub (hx₀.trans hx.symm)

