      ((hfi 2 (by norm_num) (by norm_num) p).trans (hg2 _)) (hg0b p)
      ((hgi 1 (by norm_num) (by norm_num) p).trans (hd1 _))
      ((hgi 2 (by norm_num) (by norm_num) p).trans (hd2 _))
