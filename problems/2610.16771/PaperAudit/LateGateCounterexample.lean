      simulatedAnswer (step x.1) (physicalFrame C (h x.1 0) n (frame b x.2)) (j.succ.val - 3 + 1)) :
    (sigma.prod (FangqingOrthogonalHaar.rightHaar W)).real good ≤ 1 / 2 := by
  apply actual_haar_recursive_prefix_good_event_has_probability_at_most_half sigma C (fun s => h s 0) n b hb j
    (j.succ.val - 3 + 1) (by simp only [Fin.val_succ]; omega)
    (fun x : Seed × FangqingOrthogonalHaar.Group W => runResponse c C (h x.1) (second x.1) b j offset x.2)
