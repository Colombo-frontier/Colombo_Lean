theorem actual_seed_rates_antitone_width (Ks s A0 A : ℝ)
    (hKs : 0 ≤ Ks) (hs : 0 ≤ s) (hA0 : 0 < A0) (hAA : A0 ≤ A) :
    Ks * (s * A) / A ^ 2 ≤ Ks * (s * A0) / A0 ^ 2 ∧
    Ks * (s * A) / A ^ 3 ≤ Ks * (s * A0) / A0 ^ 3 := by
  have hA : 0 < A := hA0.trans_le hAA
