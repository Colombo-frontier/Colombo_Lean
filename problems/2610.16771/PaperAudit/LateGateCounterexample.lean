theorem latePoint_has_zero_unrevealed_projections
    (n cutoff : ℕ) (current : Fin (n + 3)) (hcurrent : current.val < cutoff)
    (alpha omega tau a offset : ℝ) (handle : E) (coeff : Fin (n + 3) → ℝ)
    (V : Fin (n + 3) → E) (hV : Orthonormal ℝ V) (j : Fin (n + 3))
