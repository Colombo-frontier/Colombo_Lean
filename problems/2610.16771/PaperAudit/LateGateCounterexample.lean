  unfold prefixPoint
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : i.val < cutoff
  · rw [if_pos hi, if_pos hi, h i hi]
  · rw [if_neg hi, if_neg hi]

