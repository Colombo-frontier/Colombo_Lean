theorem prefixPoint_has_zero_unrevealed_projection
    (n cutoff : ℕ) (alpha : ℝ) (handle : E) (coeff : Fin (n + 3) → ℝ)
    (V : Fin (n + 3) → E) (hV : Orthonormal ℝ V) (j : Fin (n + 3))
