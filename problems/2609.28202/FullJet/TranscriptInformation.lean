import FullJet.FiniteInformation
import Mathlib.Data.Fin.Tuple.Basic

open scoped BigOperators

namespace FullJet

variable {β : Type*} [Fintype β]

def transcriptSplit (q : ℕ) : (Fin (q + 1) → β) ≃ β × (Fin q → β) where
  toFun v := (v 0, Fin.tail v)
  invFun z := Fin.cons z.1 z.2
  left_inv v := Fin.cons_self_tail v
  right_inv z := by simp

/-- Probability weight of a finite transcript generated by a history-dependent
transition kernel. The next transition may depend on the entire past. -/
noncomputable def transcriptWeight (K : List β → β → ℝ) (past : List β) :
    (q : ℕ) → (Fin q → β) → ℝ
  | 0, _ => 1
  | q + 1, v => K past (v 0) * transcriptWeight K (past ++ [v 0]) q (Fin.tail v)

theorem transcriptWeight_nonneg (K : List β → β → ℝ) (hK : ∀ past b, 0 ≤ K past b)
    (past : List β) (q : ℕ) (v : Fin q → β) : 0 ≤ transcriptWeight K past q v := by
  induction q generalizing past with
  | zero => simp [transcriptWeight]
  | succ q ih => exact mul_nonneg (hK _ _) (ih _ _)

theorem transcriptWeight_sum (K : List β → β → ℝ) (hK : ∀ past, ∑ b, K past b = 1)
    (past : List β) (q : ℕ) : ∑ v, transcriptWeight K past q v = 1 := by
  induction q generalizing past with
  | zero => simp [transcriptWeight]
  | succ q ih =>
    calc
      _ = ∑ z : β × (Fin q → β), K past z.1 * transcriptWeight K (past ++ [z.1]) q z.2 :=
        Fintype.sum_equiv (transcriptSplit q) _ _ (fun v => rfl)
      _ = 1 := by
        rw [Fintype.sum_prod_type]
        simp_rw [← Finset.mul_sum, ih, mul_one]
        exact hK past

theorem transcriptWeight_support (K L : List β → β → ℝ)
    (hKL : ∀ past b, K past b ≠ 0 → L past b ≠ 0)
    (past : List β) (q : ℕ) (v : Fin q → β)
    (hv : transcriptWeight K past q v ≠ 0) : transcriptWeight L past q v ≠ 0 := by
  induction q generalizing past with
  | zero => simp [transcriptWeight]
  | succ q ih =>
    obtain ⟨hfirst, htail⟩ := mul_ne_zero_iff.mp hv
    exact mul_ne_zero (hKL _ _ hfirst) (ih _ _ htail)

theorem transcriptKL_succ (K L : List β → β → ℝ)
    (hK : ∀ past, ∑ b, K past b = 1)
    (hKL : ∀ past b, K past b ≠ 0 → L past b ≠ 0) (past : List β) (q : ℕ) :
    finiteKL (transcriptWeight K past (q + 1)) (transcriptWeight L past (q + 1)) =
      finiteKL (K past) (L past) + ∑ b, K past b *
        finiteKL (transcriptWeight K (past ++ [b]) q) (transcriptWeight L (past ++ [b]) q) := by
  have heq : finiteKL (transcriptWeight K past (q + 1)) (transcriptWeight L past (q + 1)) =
      finiteKL (fun z : β × (Fin q → β) => K past z.1 * transcriptWeight K (past ++ [z.1]) q z.2)
        (fun z => L past z.1 * transcriptWeight L (past ++ [z.1]) q z.2) := by
    unfold finiteKL
    exact Fintype.sum_equiv (transcriptSplit q) _ _ (fun v => rfl)
  rw [heq]
  exact finiteKL_chain_rule _ _ _ _ (fun b => transcriptWeight_sum K hK (past ++ [b]) q)
    (hKL past) (fun b _ v hv => transcriptWeight_support K L hKL _ q v hv)

/-- A per-query information bound accumulates linearly over any finite
adaptive transcript. This proves the iteration, not just a two-step identity. -/
theorem transcriptKL_le (K L : List β → β → ℝ)
    (hK0 : ∀ past b, 0 ≤ K past b) (hK : ∀ past, ∑ b, K past b = 1)
    (hKL : ∀ past b, K past b ≠ 0 → L past b ≠ 0)
    (c : ℝ) (hstep : ∀ past, finiteKL (K past) (L past) ≤ c)
    (past : List β) (q : ℕ) :
    finiteKL (transcriptWeight K past q) (transcriptWeight L past q) ≤ q * c := by
  induction q generalizing past with
  | zero => simp [transcriptWeight, finiteKL]
  | succ q ih =>
    rw [transcriptKL_succ K L hK hKL]
    calc
      _ ≤ c + ∑ b, K past b * (q * c) := add_le_add (hstep past)
        (Finset.sum_le_sum fun b _ => mul_le_mul_of_nonneg_left (ih _) (hK0 _ _))
      _ = (q + 1 : ℕ) * c := by
        rw [← Finset.sum_mul, hK past, one_mul]
        push_cast
        ring

end FullJet
